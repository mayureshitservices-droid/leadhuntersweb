{
  "name": "leadhuntersweb",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,ejs --exec \"tsx src/index.ts\"",
    "tailwind:build": "tailwindcss -i src/public/css/input.css -o src/public/css/tailwind.css",
    "tailwind:watch": "tailwindcss -i src/public/css/input.css -o src/public/css/tailwind.css --watch",
    "build": "npm run tailwind:build && tsc && shx cp -r src/views dist/ && shx cp -r src/public dist/ && shx mkdir -p dist/config && shx cp src/config/app-version.json dist/config/",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^6.0.0",
    "connect-redis": "^9.0.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.4.1",
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "oci-common": "^2.127.0",
    "oci-objectstorage": "^2.127.0",
    "prisma": "^6.0.0",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "nodemon": "^3.1.14",
    "shx": "^0.4.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
