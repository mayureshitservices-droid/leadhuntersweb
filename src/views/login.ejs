<%- include('partials/header') %>

<style>
  html { scroll-behavior: smooth; }
  .landing-gradient {
    background: linear-gradient(180deg, var(--color-bg-light) 0%, #ffffff 100%);
  }
  /* Custom scrollbar for horizontal tabs if needed */
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
<script>
  function openWhatsApp(msg) {
    var text = encodeURIComponent(msg || "Hi, I'm interested in LeadHunters Dialer");
    var phone = "917447328144";
    var isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    if (isMobile) {
      // Direct native app open — no confirmation page
      window.location.href = "whatsapp://send?phone=" + phone + "&text=" + text;
    } else {
      // Desktop: open WhatsApp Web directly (skips the landing page)
      window.open("https://web.whatsapp.com/send?phone=" + phone + "&text=" + text, "_blank");
    }
  }
</script>

