<%- include('partials/header') %>

  <div class="space-y-8 animate-fade-in-up" x-data="{ 
    showCustomerForm: false,
    newCustomer: { name: '', email: '', password: '', phone: '', payment_terms: '30', status: 'Active' },
    submitting: false,
    errorMessage: '',
    showAssignmentModal: false,
    targetTelecaller: null,
    selectedOwnerId: '',
    modalSubmitting: false,
    assignmentSearch: ''
  }">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Super Admin Overview</h2>
      </div>
      <!-- Tab switcher removed as requested, using sidebar navigation -->
    </div>
    <div class="grid grid-cols-1 gap-6">
      <!-- Customers View -->
      <div x-show="activeTab === 'customers'" x-transition:enter="transition ease-out duration-300 transform"
        x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0"
        class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-bold text-gray-900">Customers</h3>
          <button x-show="!showCustomerForm"
            class="bg-blue-50 text-blue-600 px-3 py-1.5 rounded-lg text-sm font-medium hover:bg-blue-100 transition-colors"
            @click="showCustomerForm = true">+ New Customer</button>
        </div>

        <!-- Brand-Consistent Inline Customer Form -->
        <div x-show="showCustomerForm" x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 -translate-y-4" x-transition:enter-end="opacity-100 translate-y-0"
          class="mb-10 p-8 bg-white rounded-xl border border-gray-100 shadow-sm relative">
          <div class="mb-8">
            <h4 class="text-xl font-bold text-gray-900 tracking-tight">Register New Customer</h4>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Name -->
            <div class="space-y-1.5">
              <label class="text-sm font-bold text-gray-700 ml-0.5">Customer Name</label>
              <input type="text" x-model="newCustomer.name" placeholder="Full legal name"
                class="w-full bg-[#F5F6F8] border border-transparent rounded-xl px-4 py-3 text-sm transition-all outline-none text-gray-800"
                style="focus: border-color: #E53935; focus: background-color: #fff;"
                onfocus="this.style.borderColor='#E53935'; this.style.backgroundColor='#fff';"
                onblur="this.style.borderColor='transparent'; this.style.backgroundColor='#F5F6F8';">
            </div>

            <!-- Email -->
            <div class="space-y-1.5">
              <label class="text-sm font-bold text-gray-700 ml-0.5">Email Address</label>
              <input type="email" x-model="newCustomer.email" placeholder="email@example.com"
                class="w-full bg-[#F5F6F8] border border-transparent rounded-xl px-4 py-3 text-sm transition-all outline-none text-gray-800"
                style="focus: border-color: #E53935; focus: background-color: #fff;"
                onfocus="this.style.borderColor='#E53935'; this.style.backgroundColor='#fff';"
                onblur="this.style.borderColor='transparent'; this.style.backgroundColor='#F5F6F8';">
            </div>

            <!-- Password -->
            <div class="space-y-1.5">
              <label class="text-sm font-bold text-gray-700 ml-0.5">Password</label>
              <input type="password" x-model="newCustomer.password" placeholder="••••••••"
                class="w-full bg-[#F5F6F8] border border-transparent rounded-xl px-4 py-3 text-sm transition-all outline-none text-gray-800"
                style="focus: border-color: #E53935; focus: background-color: #fff;"
                onfocus="this.style.borderColor='#E53935'; this.style.backgroundColor='#fff';"
                onblur="this.style.borderColor='transparent'; this.style.backgroundColor='#F5F6F8';">
            </div>

            <!-- Mobile -->
            <div class="space-y-1.5">
              <label class="text-sm font-bold text-gray-700 ml-0.5">Mobile No</label>
              <input type="text" x-model="newCustomer.phone" placeholder="+91"
                class="w-full bg-[#F5F6F8] border border-transparent rounded-xl px-4 py-3 text-sm transition-all outline-none text-gray-800"
                style="focus: border-color: #E53935; focus: background-color: #fff;"
                onfocus="this.style.borderColor='#E53935'; this.style.backgroundColor='#fff';"
                onblur="this.style.borderColor='transparent'; this.style.backgroundColor='#F5F6F8';">
            </div>

            <!-- Payment -->
            <div class="space-y-1.5">
              <label class="text-sm font-bold text-gray-700 ml-0.5">Payments Terms</label>
              <select x-model="newCustomer.payment_terms"
                class="w-full bg-[#F5F6F8] border border-transparent focus:border-[#E53935] focus:bg-white rounded-xl px-4 py-3 text-sm transition-all outline-none text-gray-800 cursor-pointer">
                <option value="30">30</option>
                <option value="60">60</option>
                <option value="90">90</option>
              </select>
            </div>

            <!-- Status -->
            <div class="space-y-1.5">
              <label class="text-sm font-bold text-gray-700 ml-0.5">Status</label>
              <select x-model="newCustomer.status"
                class="w-full bg-[#F5F6F8] border border-transparent focus:border-[#E53935] focus:bg-white rounded-xl px-4 py-3 text-sm transition-all outline-none text-gray-800 cursor-pointer">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
              </select>
            </div>
          </div>

          <div x-show="errorMessage" x-transition
            class="mt-6 p-4 bg-red-50 rounded-xl border border-red-100 text-xs text-red-700 font-bold">
            <span x-text="errorMessage"></span>
          </div>

          <div
            class="flex flex-col md:flex-row items-center justify-start md:space-x-4"
            style="margin-top: 20px; padding-top: 40px; border-top: 1px solid #f9fafb;">
            <button @click="submitCustomer($data)" :disabled="submitting"
              class="text-white font-bold rounded-xl transition-all active:scale-[0.98] disabled:opacity-50 flex items-center justify-center text-sm"
              style="background-color: #E53935; padding: 12px 30px; width: auto; min-width: 150px;">
              <span x-show="!submitting">Submit</span>
              <template x-if="submitting">
                <div class="flex items-center space-x-2">
                  <svg class="animate-spin h-5 w-5 text-white" viewBox="0 0 24 24" fill="none">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                    </path>
                  </svg>
                  <span>Submitting...</span>
                </div>
              </template>
            </button>
            <button @click="showCustomerForm = false"
              class="text-gray-500 font-bold text-sm hover:text-gray-900 transition-colors py-2 px-6">Discard</button>
          </div>
        </div>

        <div class="overflow-x-auto" x-show="!showCustomerForm" x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100">
          
          <!-- Desktop Table View -->
          <table class="min-w-full divide-y divide-gray-200 desktop-only">
            <thead class="bg-gray-50/50">
              <tr>
                <th scope="col"
                  class="px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Business
                  Owner</th>
                <th scope="col"
                  class="px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Email
                  Address</th>
                <th scope="col"
                  class="px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Mobile No
                </th>
                <th scope="col"
                  class="px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Terms</th>
                <th scope="col"
                  class="px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Status</th>
                <th scope="col"
                  class="px-4 py-3 text-right text-[10px] font-bold text-gray-400 uppercase tracking-widest">Actions
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
              <% if(businessOwners.length===0) { %>
                <tr>
                  <td colspan="6" class="px-4 py-8 text-center text-sm text-gray-500 italic">No business owners
                    registered yet.</td>
                </tr>
                <% } %>
                  <% businessOwners.forEach(bo=> { %>
                    <tr class="hover:bg-gray-50 transition-colors group" x-data="{ 
                  editing: false,
                  submitting: false,
                  id: '<%= bo.id %>',
                  name: '<%= bo.name %>',
                  email: '<%= bo.email %>',
                  phone: '<%= bo.phone || '' %>',
                  payment_terms: '<%= bo.payment_terms || '30' %>',
                  status: '<%= bo.status %>',
                  temp: { name: '<%= bo.name %>', email: '<%= bo.email %>', phone: '<%= bo.phone || '' %>', payment_terms: '<%= bo.payment_terms || '30' %>' }
                }">
                      <!-- Name -->
                      <td class="px-4 py-4 whitespace-nowrap">
                        <template x-if="!editing">
                          <div class="font-bold text-gray-900 text-sm" x-text="name"></div>
                        </template>
                        <template x-if="editing">
                          <input type="text" x-model="temp.name"
                            class="w-full bg-gray-50 border border-transparent focus:border-red-300 rounded-lg px-2 py-1 text-sm outline-none">
                        </template>
                      </td>

                      <!-- Email -->
                      <td class="px-4 py-4 whitespace-nowrap">
                        <template x-if="!editing">
                          <div class="text-sm text-gray-600 font-medium" x-text="email"></div>
                        </template>
                        <template x-if="editing">
                          <input type="email" x-model="temp.email"
                            class="w-full bg-gray-50 border border-transparent focus:border-red-300 rounded-lg px-2 py-1 text-sm outline-none">
                        </template>
                      </td>

                      <!-- Mobile -->
                      <td class="px-4 py-4 whitespace-nowrap">
                        <template x-if="!editing">
                          <div class="text-sm text-gray-600 font-medium" x-text="phone || '--'"></div>
                        </template>
                        <template x-if="editing">
                          <input type="text" x-model="temp.phone"
                            class="w-full bg-gray-50 border border-transparent focus:border-red-300 rounded-lg px-2 py-1 text-sm outline-none">
                        </template>
                      </td>

                      <!-- Terms -->
                      <td class="px-4 py-4 whitespace-nowrap">
                        <template x-if="!editing">
                          <span
                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700"
                            x-text="payment_terms + ' Days'"></span>
                        </template>
                        <template x-if="editing">
                          <select x-model="temp.payment_terms"
                            class="bg-gray-50 border border-transparent focus:border-red-300 rounded-lg px-1 py-1 text-xs outline-none">
                            <option value="30">30</option>
                            <option value="60">60</option>
                            <option value="90">90</option>
                          </select>
                        </template>
                      </td>

                      <!-- Status -->
                      <td class="px-4 py-4 whitespace-nowrap">
                        <span
                          class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-tight transition-colors"
                          :class="status === 'Active' ? 'bg-green-50 text-green-600' : 'bg-red-50 text-red-500'"
                          x-text="status"></span>
                      </td>

                      <!-- Actions -->
                      <td class="px-6 py-4 whitespace-nowrap text-right text-gray-900">
                        <template x-if="!editing">
                          <div class="flex items-center justify-end" style="column-gap: 50px;">
                            <button @click="toggleStatus($data)"
                              class="text-[11px] font-bold uppercase transition-colors min-w-[80px] text-left"
                              :class="status === 'Active' ? 'text-blue-500 hover:text-blue-700' : 'text-green-500 hover:text-green-700'"
                              x-text="status === 'Active' ? 'Deactivate' : 'Activate'"></button>
                            <button @click="editing = true"
                              class="text-[11px] font-bold uppercase text-gray-400 hover:text-gray-900 transition-colors flex items-center">
                              <svg class="w-3.5 h-3.5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                              </svg>
                              Edit
                            </button>
                            <button @click="confirmAndDelete($data)"
                              class="text-[11px] font-bold uppercase text-red-300 hover:text-red-500 transition-colors flex items-center">
                              <svg class="w-3.5 h-3.5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M19 7l-.867 12.142A2 2.001 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                              </svg>
                              Delete
                            </button>
                          </div>
                        </template>
                        <template x-if="editing">
                          <div class="flex items-center justify-end space-x-2">
                            <button @click="saveChanges($data)" :disabled="submitting"
                              class="bg-primary text-white text-[10px] font-bold px-3 py-1 rounded-lg hover:opacity-90">
                              <span x-show="!submitting">Save</span>
                              <span x-show="submitting">...</span>
                            </button>
                            <button @click="editing = false"
                              class="text-[10px] font-bold text-gray-400 hover:text-gray-600 px-1">✕</button>
                          </div>
                        </template>
                      </td>
                    </tr>
                    <% }) %>
            </tbody>
          </table>

          <!-- Mobile Card View -->
          <div class="mobile-only space-y-4">
            <% if(businessOwners.length === 0) { %>
              <div class="py-8 text-center text-sm text-gray-500 italic bg-gray-50 rounded-xl">No business owners registered yet.</div>
            <% } %>
            <% businessOwners.forEach(bo => { %>
              <div 
                class="bg-white p-5 rounded-xl border border-gray-100 shadow-md space-y-5"
                x-data="{ 
                  editing: false,
                  submitting: false,
                  id: '<%= bo.id %>',
                  name: '<%= bo.name %>',
                  email: '<%= bo.email %>',
                  phone: '<%= bo.phone || '' %>',
                  payment_terms: '<%= bo.payment_terms || '30' %>',
                  status: '<%= bo.status %>',
                  temp: { name: '<%= bo.name %>', email: '<%= bo.email %>', phone: '<%= bo.phone || '' %>', payment_terms: '<%= bo.payment_terms || '30' %>' }
                }"
              >
                <!-- Card Header: Name -->
                <div class="flex justify-between items-start">
                  <div class="space-y-1 flex-1">
                    <template x-if="!editing">
                      <div class="font-bold text-gray-900 text-lg leading-tight" x-text="name"></div>
                    </template>
                    <template x-if="editing">
                      <input type="text" x-model="temp.name" class="w-full bg-gray-50 border border-red-100 rounded-lg px-3 py-2 text-sm font-bold outline-none focus:border-red-400 transition-all">
                    </template>
                    
                    <div class="flex flex-col space-y-0.5">
                      <template x-if="!editing">
                        <span class="text-sm text-gray-500 font-medium select-all" x-text="email"></span>
                      </template>
                      <template x-if="editing">
                        <input type="email" x-model="temp.email" class="w-full bg-gray-50 border border-gray-100 rounded-lg px-3 py-1.5 text-xs outline-none focus:border-red-400 mt-2">
                      </template>
                      
                      <template x-if="!editing">
                        <span class="text-base text-gray-700 font-bold mt-1" x-text="phone || 'No mobile number'"></span>
                      </template>
                      <template x-if="editing">
                        <input type="text" x-model="temp.phone" class="w-full bg-gray-50 border border-gray-100 rounded-lg px-3 py-1.5 text-xs outline-none focus:border-red-400 mt-1">
                      </template>
                    </div>
                  </div>
                </div>

                <!-- Payment Terms removed to save space -->

                <!-- Card Actions -->
                <div class="flex items-center justify-between pt-1">
                  <template x-if="!editing">
                    <div class="flex items-center justify-between w-full">
                      <button @click="toggleStatus($data)" 
                        class="text-xs font-bold uppercase px-3 py-1.5 rounded-lg transition-all"
                        :class="status === 'Active' ? 'text-blue-600 bg-blue-50' : 'text-green-600 bg-green-50'"
                        x-text="status === 'Active' ? 'Deactivate' : 'Activate'"></button>
                      
                      <div class="flex space-x-3">
                        <button @click="editing = true" class="p-2 text-gray-400 hover:text-gray-900 border border-gray-100 rounded-lg transition-all">
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                        </button>
                        <button @click="confirmAndDelete($data)" class="p-2 text-red-500 hover:text-red-700 border border-red-50 rounded-lg transition-all" style="color: #E53935;">
                          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2.001 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                        </button>
                      </div>
                    </div>
                  </template>
                  <template x-if="editing">
                    <div class="flex items-center space-x-3 w-full">
                      <button @click="saveChanges($data)" :disabled="submitting" 
                        class="flex-1 text-white font-bold py-2.5 rounded-xl transition-all shadow-sm active:scale-95 text-sm"
                        style="background-color: #E53935;">
                        <span x-show="!submitting">Save Changes</span>
                        <span x-show="submitting">Saving...</span>
                      </button>
                      <button @click="editing = false" class="px-4 py-2.5 text-sm font-bold text-gray-500 hover:text-gray-900 transition-colors">Cancel</button>
                    </div>
                  </template>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

    </div>

    <!-- Telecallers View -->
    <div x-show="activeTab === 'telecallers'" x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0"
      class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold text-gray-900">Telecallers</h3>
        <button
          class="bg-container text-primary px-3 py-1.5 rounded-lg text-sm font-medium hover:bg-red-100 transition-colors"
          onclick="alert('Feature coming soon')">+ New Telecaller</button>
      </div>
      <div class="overflow-x-auto">
        <!-- Desktop Table View -->
        <table class="min-w-full divide-y divide-gray-200 desktop-only">
          <thead class="bg-gray-50/50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">
                Telecaller / Device Alias</th>
              <th scope="col" class="px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">
                Hardware Information</th>
              <th scope="col"
                class="px-4 py-3 text-right text-[10px] font-bold text-gray-400 uppercase tracking-widest">Assignment
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-100">
            <% if(telecallers.length===0) { %>
              <tr>
                <td colspan="3" class="px-4 py-8 text-center text-sm text-gray-500 italic">No telecallers registered
                  yet.</td>
              </tr>
              <% } %>
                <% telecallers.forEach(tc=> { %>
                  <tr class="hover:bg-gray-50 transition-colors" x-data="{ 
                  editing: <%= !tc.device_alias %>, 
                  alias: '<%= tc.device_alias || '' %>', 
                  tempAlias: '<%= tc.device_alias || '' %>',
                  loading: false 
                }">
                    <td class="px-4 py-4">
                      <div class="flex items-center space-x-2 min-h-[32px]">
                        <template x-if="!editing">
                          <div class="flex items-center space-x-3 group">
                            <span class="font-bold text-gray-900 text-sm" x-text="alias"></span>
                            <button @click="editing = true; tempAlias = alias"
                              class="opacity-0 group-hover:opacity-100 text-gray-400 hover:text-red-600 transition-all ml-1"
                              title="Edit Alias">
                              <svg xmlns="http://www.w3.org/2000/svg" style="width: 14px; height: 14px;" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                              </svg>
                            </button>
                          </div>
                        </template>

                        <template x-if="editing">
                          <div class="flex items-center space-x-2 animate-fade-in">
                            <input type="text" x-model="tempAlias" placeholder="Device name"
                              class="border border-gray-200 rounded-lg px-2 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-red-50 focus:border-red-400 w-36 transition-all"
                              @keyup.enter="saveAlias('<%= tc.id %>', tempAlias, $data)">
                            <button @click="saveAlias('<%= tc.id %>', tempAlias, $data)" :disabled="loading"
                              class="bg-primary text-white text-[10px] font-bold px-3 py-1.5 rounded-lg hover:opacity-90 transition-all flex items-center">
                              <span x-show="!loading">Save</span>
                              <span x-show="loading">...</span>
                            </button>
                            <button x-show="alias" @click="editing = false"
                              class="text-[10px] text-gray-400 hover:text-red-600 px-1">✕</button>
                          </div>
                        </template>
                      </div>
                    </td>
                    <td class="px-4 py-4 whitespace-nowrap">
                      <div class="text-xs text-gray-700 font-medium">Model: <%= tc.name %>
                      </div>
                      <div class="text-[10px] text-gray-400 font-mono mt-0.5">ID: <%= tc.device_id || 'N/A' %>
                      </div>
                    </td>
                    <td class="px-4 py-4 whitespace-nowrap text-right">
                      <button
                        @click="openAssignmentModal({id: '<%= tc.id %>', alias: '<%= tc.device_alias || tc.name %>' }, $data)"
                        class="bg-container text-primary text-xs font-bold px-4 py-1.5 rounded-lg hover:bg-red-100 transition-all">
                        Set Owner
                      </button>
                    </td>
                  </tr>
                  <% }) %>
          </tbody>
        </table>

        <!-- Mobile Card View -->
        <div class="mobile-only space-y-4">
          <% if(telecallers.length === 0) { %>
            <div class="py-8 text-center text-sm text-gray-500 italic bg-gray-50 rounded-xl">No telecallers registered yet.</div>
          <% } %>
          <% telecallers.forEach(tc => { %>
            <div 
              class="bg-white p-5 rounded-xl border border-gray-100 shadow-md space-y-4"
              x-data="{ 
                editing: <%= !tc.device_alias %>, 
                alias: '<%= tc.device_alias || '' %>', 
                tempAlias: '<%= tc.device_alias || '' %>',
                loading: false 
              }"
            >
              <!-- Card Header: Alias & Status -->
              <div class="flex justify-between items-start">
                <div class="flex-1">
                  <template x-if="!editing">
                    <div class="flex items-center space-x-2">
                       <span class="font-bold text-gray-900 text-base" x-text="alias"></span>
                       <button @click="editing = true; tempAlias = alias" class="text-gray-400 hover:text-red-600 transition-all">
                          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                          </svg>
                       </button>
                    </div>
                  </template>
                  
                  <template x-if="editing">
                    <div class="flex items-center space-x-2">
                      <input 
                        type="text" 
                        x-model="tempAlias" 
                        placeholder="Device name" 
                        class="border border-gray-200 rounded-lg px-2 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-red-50 focus:border-red-400 w-full transition-all"
                        @keyup.enter="saveAlias('<%= tc.id %>', tempAlias, $data)"
                      >
                      <button 
                        @click="saveAlias('<%= tc.id %>', tempAlias, $data)" 
                        :disabled="loading"
                        class="bg-primary text-white text-[10px] font-bold px-3 py-1.5 rounded-lg hover:opacity-90 transition-all"
                      >
                        <span x-show="!loading">Save</span>
                        <span x-show="loading">...</span>
                      </button>
                    </div>
                  </template>
                </div>
              </div>

              <!-- Device Info -->
              <div class="grid grid-cols-1 gap-2 py-3 border-y border-gray-50">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Model</span>
                  <span class="text-xs text-gray-700 font-medium"><%= tc.name %></span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Hardware ID</span>
                  <span class="text-[10px] text-gray-400 font-mono"><%= tc.device_id || 'N/A' %></span>
                </div>
              </div>

              <!-- Card Actions -->
              <div class="pt-1">
                <button 
                  class="w-full text-white text-sm font-bold py-4 rounded-xl transition-all active:scale-95 shadow-md hover:opacity-90"
                  style="background-color: #E53935;"
                  @click="openAssignmentModal({id: '<%= tc.id %>', alias: '<%= tc.device_alias || tc.name %>' }, $data)"
                >
                  Set Business Owner
                </button>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
  <!-- Telecaller Assignment Modal -->
  <template x-teleport="body">
    <div x-show="showAssignmentModal" 
         class="fixed inset-0 z-[100] flex items-center justify-center p-4 sm:p-6"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0">
      
      <!-- Backdrop -->
      <div class="absolute inset-0 z-0" 
           style="background-color: rgba(0, 0, 0, 0.5); backdrop-filter: blur(8px);"
           @click="showAssignmentModal = false"></div>

      <!-- Modal Content -->
      <div class="relative bg-white flex flex-col animate-fade-in-up" 
           style="width: 100%; max-width: 450px; max-height: 85vh; border-radius: 24px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); overflow: hidden; z-index: 10;">
        
        <!-- Header -->
        <div class="p-6 border-b border-gray-100" style="padding: 24px; border-bottom: 1px solid #f3f4f6;">
          <div class="flex items-center justify-between mb-2" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
            <h3 class="text-xl font-bold text-gray-900" style="margin: 0; font-size: 1.25rem; font-weight: 700;">Set Telecaller Owner</h3>
            <button @click="showAssignmentModal = false" style="background: transparent; border: none; color: #9ca3af; cursor: pointer; padding: 4px;">
              <svg style="width: 24px; height: 24px;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </div>
          <p style="margin: 0; font-size: 0.875rem; color: #6b7280;">
             Assigning owner for: <span style="font-weight: 700; color: #111827;" x-text="targetTelecaller?.alias"></span>
          </p>
        </div>

        <!-- Scrollable List -->
        <div class="flex-1 overflow-y-auto" style="padding: 16px; flex: 1; overflow-y: auto; background: #fff;">
          <div x-show="modalSubmitting" style="padding: 40px 0; text-align: center;">
             <div class="animate-spin" style="width: 32px; height: 32px; border: 3px solid #f3f4f6; border-top-color: #ef4444; border-radius: 50%; display: inline-block;"></div>
             <p style="font-size: 0.75rem; color: #9ca3af; font-weight: 700; margin-top: 12px;">Loading...</p>
          </div>

          <template x-if="!modalSubmitting">
            <div style="display: flex; flex-direction: column; gap: 4px;">
              <label 
                style="display: flex; align-items: center; padding: 12px; border-radius: 12px; cursor: pointer; transition: background 0.2s;"
                :style="selectedOwnerId === '' ? 'background: rgba(254, 242, 242, 0.5)' : 'background: transparent'"
                onmouseover="this.style.backgroundColor='rgba(249, 250, 251, 1)'"
                onmouseout="this.style.backgroundColor=selectedOwnerId === '' ? 'rgba(254, 242, 242, 0.5)' : 'transparent'">
                <input type="radio" name="owner_select" value="" x-model="selectedOwnerId"
                  style="width: 18px; height: 18px; cursor: pointer; accent-color: #ef4444;">
                <div style="margin-left: 16px;">
                  <div style="font-size: 0.875rem; font-weight: 700; color: #111827;">None (Unassign)</div>
                </div>
              </label>
              <% businessOwners.forEach(bo => { %>
                <label 
                  style="display: flex; align-items: center; padding: 12px; border-radius: 12px; cursor: pointer; transition: background 0.2s;"
                  :style="selectedOwnerId === '<%= bo.id %>' ? 'background: rgba(254, 242, 242, 0.5)' : 'background: transparent'"
                  onmouseover="this.style.backgroundColor='rgba(249, 250, 251, 1)'"
                  onmouseout="this.style.backgroundColor=selectedOwnerId === '<%= bo.id %>' ? 'rgba(254, 242, 242, 0.5)' : 'transparent'">
                  <input type="radio" name="owner_select" value="<%= bo.id %>" x-model="selectedOwnerId"
                    style="width: 18px; height: 18px; cursor: pointer; accent-color: #ef4444;">
                  <div style="margin-left: 16px;">
                    <div style="font-size: 0.875rem; font-weight: 700; color: #111827;"><%= bo.name %></div>
                    <div style="font-size: 0.625rem; font-weight: 500; color: #6b7280; text-transform: uppercase; letter-spacing: 0.025em;"><%= bo.email %></div>
                  </div>
                </label>
              <% }) %>
            </div>
          </template>
        </div>

        <!-- Footer -->
        <div style="padding: 24px; border-top: 1px solid #f3f4f6; background: #fafafa; display: flex; gap: 12px;">
          <button @click="saveTelecallerOwner($data)" 
                  :disabled="modalSubmitting"
                  style="flex: 1; height: 50px; border: none; border-radius: 14px; font-weight: 700; color: #fff; background: #e53935; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: opacity 0.2s;"
                  onmouseover="this.style.opacity='0.9'"
                  onmouseout="this.style.opacity='1'">
            <span x-show="!modalSubmitting">Save</span>
            <template x-if="modalSubmitting">
              <div style="display: flex; align-items: center; gap: 8px;">
                 <div class="animate-spin" style="width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%;"></div>
                 <span>Saving...</span>
              </div>
            </template>
          </button>
          <button @click="showAssignmentModal = false" style="background: transparent; border: none; font-size: 0.875rem; font-weight: 700; color: #6b7280; padding: 0 16px; cursor: pointer;">Cancel</button>
        </div>
      </div>
    </div>
  </template>

  </div>
  </div>

    <!-- Live Status View -->
    <div x-show="activeTab === 'status'" x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0"
      class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold text-gray-900">Telecaller Live Status</h3>
        <span class="text-xs text-gray-400 font-medium" id="status-last-updated"></span>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50/50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Name</th>
              <th scope="col" class="px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Status</th>
              <th scope="col" class="px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Last Seen</th>
            </tr>
          </thead>
          <tbody id="admin-telecaller-status-tbody" class="bg-white divide-y divide-gray-100">
            <tr>
              <td colspan="3" class="px-4 py-8 text-center text-sm text-gray-500 italic">Loading...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  <script>
    /* eslint-disable */
    async function saveAlias(telecallerId, deviceAlias, data) {
      data.loading = true;
      try {
        const response = await fetch('/admin/update-device-alias', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ telecallerId, deviceAlias })
        });

        if (response.ok) {
          data.alias = deviceAlias;
          data.editing = false;
        } else {
          alert('Failed to update alias');
        }
      } catch (error) {
        console.error(error);
        alert('An error occurred');
      } finally {
        data.loading = false;
      }
    }

    async function toggleStatus(data) {
      const newStatus = data.status === 'Active' ? 'Inactive' : 'Active';
      try {
        const response = await fetch('/admin/update-customer-status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: data.id, status: newStatus })
        });
        if (response.ok) {
          data.status = newStatus;
        } else {
          alert('Failed to update status');
        }
      } catch (error) {
        console.error(error);
        alert('Network error');
      }
    }

    async function saveChanges(data) {
      data.submitting = true;
      try {
        const response = await fetch('/admin/update-customer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: data.id,
            name: data.temp.name,
            email: data.temp.email,
            phone: data.temp.phone,
            payment_terms: data.temp.payment_terms
          })
        });
        if (response.ok) {
          data.name = data.temp.name;
          data.email = data.temp.email;
          data.phone = data.temp.phone;
          data.payment_terms = data.temp.payment_terms;
          data.editing = false;
        } else {
          const res = await response.json();
          alert(res.error || 'Failed to update customer');
        }
      } catch (error) {
        console.error(error);
        alert('Network error');
      } finally {
        data.submitting = false;
      }
    }

    async function openAssignmentModal(tc, xData) {
      xData.targetTelecaller = tc;
      xData.selectedOwnerId = '';
      xData.showAssignmentModal = true;
      xData.modalSubmitting = true;
      
      try {
        const response = await fetch(`/admin/telecaller-owner/${tc.id}`);
        if (response.ok) {
          const data = await response.json();
          xData.selectedOwnerId = data.owner_id || '';
        }
      } catch (error) {
        console.error('Error fetching owner:', error);
      } finally {
        xData.modalSubmitting = false;
      }
    }

    async function saveTelecallerOwner(xData) {
      xData.modalSubmitting = true;
      try {
        const response = await fetch('/admin/set-telecaller-owner', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            telecallerId: xData.targetTelecaller.id,
            businessOwnerId: xData.selectedOwnerId
          })
        });

        if (response.ok) {
          xData.showAssignmentModal = false;
        } else {
          alert('Failed to save owner');
        }
      } catch (error) {
        console.error('Error saving owner:', error);
        alert('Network error');
      } finally {
        xData.modalSubmitting = false;
      }
    }

    async function confirmAndDelete(data) {
      if (!confirm(`Are you sure you want to delete ${data.name}? This action cannot be undone.`)) return;
      try {
        const response = await fetch('/admin/delete-customer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: data.id })
        });
        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to delete customer');
        }
      } catch (error) {
        console.error(error);
        alert('Network error');
      }
    }

    async function submitCustomer(data) {
      data.submitting = true;
      data.errorMessage = '';

      try {
        const response = await fetch('/admin/create-customer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data.newCustomer)
        });

        const result = await response.json();

        if (response.ok) {
          window.location.reload();
        } else {
          data.errorMessage = result.error || 'Failed to create customer.';
        }
      } catch (error) {
        data.errorMessage = 'Network error occurred.';
        console.error(error);
      } finally {
        data.submitting = false;
      }
    }

    // Telecaller status polling for admin
    async function fetchAdminTelecallerStatuses() {
      const tbody = document.getElementById('admin-telecaller-status-tbody');
      const lastUpdated = document.getElementById('status-last-updated');
      if (!tbody) return;
      try {
        const resp = await fetch('/api/v1/telecaller/statuses');
        const data = await resp.json();
        if (!data.telecallers || data.telecallers.length === 0) {
          tbody.innerHTML = '<tr><td colspan="3" class="px-4 py-8 text-center text-sm text-gray-500 italic">No telecallers yet</td></tr>';
          if (lastUpdated) lastUpdated.textContent = '';
          return;
        }
        tbody.innerHTML = data.telecallers.map(tc => {
          const dotColor = tc.status === 'idle' ? 'bg-green-500' : tc.status === 'on_call' ? 'bg-red-500' : 'bg-gray-300';
          const statusLabel = tc.status === 'on_call' ? 'On Call' : tc.status.charAt(0).toUpperCase() + tc.status.slice(1);
          return `<tr class="hover:bg-gray-50 transition-colors">
            <td class="px-4 py-4 whitespace-nowrap font-bold text-gray-900 text-sm">${tc.name}</td>
            <td class="px-4 py-4 whitespace-nowrap"><span class="inline-flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full ${dotColor}"></span><span class="text-sm font-medium text-gray-700">${statusLabel}</span></span></td>
            <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500">${tc.last_seen_human}</td>
          </tr>`;
        }).join('');
        if (lastUpdated) lastUpdated.textContent = `Updated ${new Date().toLocaleTimeString()}`;
      } catch (e) {
        console.error('Failed to fetch telecaller statuses:', e);
      }
    }

    setInterval(fetchAdminTelecallerStatuses, 15000);
    document.addEventListener('DOMContentLoaded', fetchAdminTelecallerStatuses);
    setTimeout(fetchAdminTelecallerStatuses, 500);
  </script>

  <style>
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in-up {
      animation: fadeInUp 0.4s ease-out forwards;
    }

    .animate-fade-in {
      animation: fadeIn 0.3s ease-out forwards;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }

    /* Standard Responsive Visibility Fixes */
    @media (min-width: 768px) {
      .mobile-only { display: none !important; }
      .desktop-only { display: table !important; }
      div.desktop-only { display: block !important; }
    }
    @media (max-width: 767px) {
      .mobile-only { display: block !important; }
      .desktop-only { display: none !important; }
    }
  </style>

