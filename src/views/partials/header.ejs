<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LeadHunters Web</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/tailwind.css" rel="stylesheet">
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="bg-bg-light font-sans text-gray-800 antialiased min-h-screen flex" 
  x-data="{ 
    sidebarOpen: false, 
    sidebarCollapsed: localStorage.getItem('sidebarCollapsed') === null ? true : localStorage.getItem('sidebarCollapsed') === 'true',
    selectedAgent: 'all',
    activeTab: new URLSearchParams(window.location.search).get('tab') || (window.location.pathname === '/owner' ? 'upload' : 'customers'),
    leadModalOpen: false,
    selectedLead: null,
    displayStatus: '',
    exportStart: '',
    exportEnd: '',
    deleteModalOpen: false,
    campaignToDelete: '',
    pendingLeadsToDelete: 0
  }"
  x-init="
    $watch('activeTab', value => {
      if (window.location.pathname === '/admin' || window.location.pathname === '/owner') {
        const url = new URL(window.location);
        url.searchParams.set('tab', value);
        window.history.replaceState({}, '', url);
      }
    });
    $watch('sidebarCollapsed', value => {
      localStorage.setItem('sidebarCollapsed', value);
    });
  "
>
  <script>const socket = typeof io !== 'undefined' ? io() : null;</script>

  <% if (locals.user) { %>
  <!-- Mobile Sidebar Overlay -->
  <div x-show="sidebarOpen" x-transition.opacity class="fixed inset-0 z-20 lg:hidden" 
    style="background-color: rgba(0, 0, 0, 0.4); backdrop-filter: blur(4px);"
    @click="sidebarOpen = false"></div>

  <!-- Sidebar -->
  <aside 
    :class="[
      sidebarOpen ? 'translate-x-0' : '-translate-x-full',
      sidebarCollapsed ? 'lg:w-20' : 'lg:w-64'
    ]" 
    class="fixed inset-y-0 left-0 z-30 w-64 bg-white border-r border-gray-100 shadow-xl transition-all duration-300 transform lg:translate-x-0 lg:static lg:inset-0 flex flex-col relative">
    
    <!-- Floating Shrink/Expand Toggle Button (Visible only on Desktop) -->
    <button 
      @click="sidebarCollapsed = !sidebarCollapsed" 
      class="hidden lg:flex absolute top-6 -right-3 z-40 items-center justify-center w-6 h-6 bg-white border border-gray-100 rounded-full shadow-md text-gray-500 hover:text-primary transition-transform duration-200 cursor-pointer focus:outline-none"
      aria-label="Toggle Sidebar">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 transition-transform duration-300" :class="sidebarCollapsed ? '' : 'rotate-180'">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>

    <div class="flex items-center justify-center h-20 border-b border-gray-100 bg-container bg-opacity-30 px-4 transition-all duration-300">
      <div 
        class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white shadow-lg hover:rotate-12 transition-all duration-300 shrink-0"
        :class="sidebarCollapsed ? 'lg:mr-0' : 'mr-3'">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
        </svg>
      </div>
      <span x-show="!sidebarCollapsed" x-transition.opacity.duration.200ms class="text-2xl font-bold text-gray-900 tracking-tight whitespace-nowrap">LeadHunters</span>
    </div>

    <nav class="flex-1 px-4 py-6 space-y-2 flex flex-col relative transition-all duration-300 overflow-y-auto hidden-scrollbar" :class="sidebarCollapsed ? 'lg:px-2' : 'lg:px-4'">

      <% if (user.role === 'SUPER_ADMIN') { %>
      <div class="pt-4 pb-2 flex transition-all" :class="sidebarCollapsed ? 'lg:justify-center lg:px-0' : 'px-4'">
        <span x-show="!sidebarCollapsed" x-transition.opacity class="text-[10px] font-bold text-gray-400 uppercase tracking-widest whitespace-nowrap">Management</span>
        <span x-show="sidebarCollapsed" x-transition.opacity class="hidden lg:inline text-[10px] font-bold text-gray-400 uppercase tracking-widest">M</span>
      </div>

      <a href="/admin?tab=customers" 
         @click.prevent="if(window.location.pathname === '/admin') { activeTab = 'customers'; sidebarOpen = false; } else { window.location.href = '/admin?tab=customers' }"
         class="flex items-center rounded-xl transition-all duration-200 group"
         :class="[
           (window.location.pathname === '/admin' && activeTab === 'customers') ? 'bg-container text-primary shadow-sm' : 'text-gray-600 hover:bg-container hover:text-primary',
           sidebarCollapsed ? 'lg:justify-center lg:py-3 lg:px-0' : 'px-4 py-3'
         ]">
        <svg class="w-5 h-5 group-hover:scale-110 transition-transform shrink-0" :class="sidebarCollapsed ? 'lg:mr-0' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <span x-show="!sidebarCollapsed" x-transition.opacity.duration.200ms class="font-medium whitespace-nowrap">Customers</span>
      </a>

      <a href="/admin?tab=telecallers" 
         @click.prevent="if(window.location.pathname === '/admin') { activeTab = 'telecallers'; sidebarOpen = false; } else { window.location.href = '/admin?tab=telecallers' }"
         class="flex items-center rounded-xl transition-all duration-200 group"
         :class="[
           (window.location.pathname === '/admin' && activeTab === 'telecallers') ? 'bg-container text-primary shadow-sm' : 'text-gray-600 hover:bg-container hover:text-primary',
           sidebarCollapsed ? 'lg:justify-center lg:py-3 lg:px-0' : 'px-4 py-3'
         ]">
        <svg class="w-5 h-5 group-hover:scale-110 transition-transform shrink-0" :class="sidebarCollapsed ? 'lg:mr-0' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        <span x-show="!sidebarCollapsed" x-transition.opacity.duration.200ms class="font-medium whitespace-nowrap">Telecallers</span>
      </a>

      <a href="/admin?tab=status" 
         @click.prevent="if(window.location.pathname === '/admin') { activeTab = 'status'; sidebarOpen = false; } else { window.location.href = '/admin?tab=status' }"
         class="flex items-center rounded-xl transition-all duration-200 group"
         :class="[
           (window.location.pathname === '/admin' && activeTab === 'status') ? 'bg-container text-primary shadow-sm' : 'text-gray-600 hover:bg-container hover:text-primary',
           sidebarCollapsed ? 'lg:justify-center lg:py-3 lg:px-0' : 'px-4 py-3'
         ]">
        <svg class="w-5 h-5 group-hover:scale-110 transition-transform shrink-0" :class="sidebarCollapsed ? 'lg:mr-0' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span x-show="!sidebarCollapsed" x-transition.opacity.duration.200ms class="font-medium whitespace-nowrap">Live Status</span>
      </a>

      <!-- Download Android App -->
      <div class="pt-4 pb-2 flex transition-all" :class="sidebarCollapsed ? 'lg:justify-center lg:px-0' : 'px-4'">
        <span x-show="!sidebarCollapsed" x-transition.opacity class="text-[10px] font-bold text-gray-400 uppercase tracking-widest whitespace-nowrap">App</span>
        <span x-show="sidebarCollapsed" x-transition.opacity class="hidden lg:inline text-[10px] font-bold text-gray-400 uppercase tracking-widest">A</span>
      </div>
      <a href="/downloads/app-release.apk" download
         class="flex items-center rounded-xl transition-all duration-200 group bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 hover:border-emerald-300 hover:shadow-sm"
         :class="sidebarCollapsed ? 'lg:justify-center lg:py-3 lg:px-0' : 'px-4 py-3'">
        <svg class="w-5 h-5 group-hover:scale-110 group-hover:-translate-y-0.5 transition-transform shrink-0" :class="sidebarCollapsed ? 'lg:mr-0' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18.5l-6-6m6 6l6-6m-6 6V3" />
        </svg>
        <div x-show="!sidebarCollapsed" x-transition.opacity.duration.200ms class="flex flex-col">
          <span class="font-semibold text-sm leading-tight whitespace-nowrap">Download App</span>
          <span class="text-[10px] text-emerald-500 font-medium">Android APK</span>
        </div>
      </a>

      <% } else if (user.role === 'BUSINESS_OWNER') { %>
      <div class="pt-4 pb-2 flex transition-all" :class="sidebarCollapsed ? 'lg:justify-center lg:px-0' : 'px-4'">
        <span x-show="!sidebarCollapsed" x-transition.opacity class="text-[10px] font-bold text-gray-400 uppercase tracking-widest whitespace-nowrap">Leads & Activity</span>
        <span x-show="sidebarCollapsed" x-transition.opacity class="hidden lg:inline text-[10px] font-bold text-gray-400 uppercase tracking-widest">L</span>
      </div>

      <a href="/owner?tab=upload" 
         @click.prevent="if(window.location.pathname === '/owner') { activeTab = 'upload'; sidebarOpen = false; } else { window.location.href = '/owner?tab=upload' }"
         class="flex items-center rounded-xl transition-all duration-200 group"
         :class="[
           (window.location.pathname === '/owner' && activeTab === 'upload') ? 'bg-container text-primary shadow-sm' : 'text-gray-600 hover:bg-container hover:text-primary',
           sidebarCollapsed ? 'lg:justify-center lg:py-3 lg:px-0' : 'px-4 py-3'
         ]">
        <svg class="w-5 h-5 group-hover:scale-110 transition-transform shrink-0" :class="sidebarCollapsed ? 'lg:mr-0' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        <span x-show="!sidebarCollapsed" x-transition.opacity.duration.200ms class="font-medium whitespace-nowrap">Upload Leads</span>
      </a>

      <a href="/owner?tab=activity" 
         @click.prevent="if(window.location.pathname === '/owner') { activeTab = 'activity'; sidebarOpen = false; } else { window.location.href = '/owner?tab=activity' }"
         class="flex items-center rounded-xl transition-all duration-200 group"
         :class="[
           (window.location.pathname === '/owner' && activeTab === 'activity') ? 'bg-container text-primary shadow-sm' : 'text-gray-600 hover:bg-container hover:text-primary',
           sidebarCollapsed ? 'lg:justify-center lg:py-3 lg:px-0' : 'px-4 py-3'
         ]">
        <svg class="w-5 h-5 group-hover:scale-110 transition-transform shrink-0" :class="sidebarCollapsed ? 'lg:mr-0' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span x-show="!sidebarCollapsed" x-transition.opacity.duration.200ms class="font-medium whitespace-nowrap">Detailed View</span>
      </a>

      <a href="/owner?tab=performance" 
         @click.prevent="if(window.location.pathname === '/owner') { activeTab = 'performance'; sidebarOpen = false; } else { window.location.href = '/owner?tab=performance' }"
         class="flex items-center rounded-xl transition-all duration-200 group"
         :class="[
           (window.location.pathname === '/owner' && activeTab === 'performance') ? 'bg-container text-primary shadow-sm' : 'text-gray-600 hover:bg-container hover:text-primary',
           sidebarCollapsed ? 'lg:justify-center lg:py-3 lg:px-0' : 'px-4 py-3'
         ]">
        <svg class="w-5 h-5 group-hover:scale-110 transition-transform shrink-0" :class="sidebarCollapsed ? 'lg:mr-0' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2-2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2" />
        </svg>
        <span x-show="!sidebarCollapsed" x-transition.opacity.duration.200ms class="font-medium whitespace-nowrap">Performance</span>
      </a>

      <a href="/owner?tab=campaigns" 
         @click.prevent="if(window.location.pathname === '/owner') { activeTab = 'campaigns'; sidebarOpen = false; } else { window.location.href = '/owner?tab=campaigns' }"
         class="flex items-center rounded-xl transition-all duration-200 group"
         :class="[
           (window.location.pathname === '/owner' && activeTab === 'campaigns') ? 'bg-container text-primary shadow-sm' : 'text-gray-600 hover:bg-container hover:text-primary',
           sidebarCollapsed ? 'lg:justify-center lg:py-3 lg:px-0' : 'px-4 py-3'
         ]">
        <svg class="w-5 h-5 group-hover:scale-110 transition-transform shrink-0" :class="sidebarCollapsed ? 'lg:mr-0' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <span x-show="!sidebarCollapsed" x-transition.opacity.duration.200ms class="font-medium whitespace-nowrap">Campaigns</span>
      </a>

      <% } %>

      <a href="/logout" 
         class="flex items-center text-gray-600 hover:bg-red-50 hover:text-red-700 rounded-xl transition-all duration-200 group mt-auto"
         :class="sidebarCollapsed ? 'lg:justify-center lg:py-3 lg:px-0' : 'px-4 py-3'">
        <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform shrink-0" :class="sidebarCollapsed ? 'lg:mr-0' : 'mr-3'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        <span x-show="!sidebarCollapsed" x-transition.opacity.duration.200ms class="font-medium whitespace-nowrap">Sign Out</span>
      </a>
    </nav>
  </aside>

  <!-- Main Content Wrapper -->
  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <!-- Mobile Header Bar -->
    <header class="bg-white border-b border-gray-100 lg:hidden flex items-center justify-between px-4 py-3 shadow-sm z-10 sticky top-0">
      <button @click="sidebarOpen = true" class="text-gray-500 hover:text-primary focus:outline-none p-2 rounded-md hover:bg-gray-100 transition-colors">
        <svg fill="currentColor" viewBox="0 0 20 20" class="w-6 h-6">
          <path fill-rule="evenodd" d="M3 5h14a1 1 0 010 2H3a1 1 0 010-2zM3 10h14a1 1 0 010 2H3a1 1 0 010-2zM3 15h14a1 1 0 010 2H3a1 1 0 010-2z" clip-rule="evenodd"></path>
        </svg>
      </button>
      <span class="text-lg font-bold text-gray-900">LeadHunters</span>
      <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center font-bold shadow-md">
        <%= user.name.charAt(0).toUpperCase() %>
      </div>
    </header>
  <% } else { %>
  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
  <% } %>

    <main class="flex-1 overflow-y-auto px-2 sm:px-6 lg:px-8 py-8 w-full max-w-7xl mx-auto">
