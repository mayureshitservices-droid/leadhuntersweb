<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LeadHunters Web</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/tailwind.css" rel="stylesheet">
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-bg-light font-sans text-gray-800 antialiased min-h-screen flex" 
  x-data="{ 
    sidebarOpen: false, 
    activeTab: new URLSearchParams(window.location.search).get('tab') || 'customers' 
  }"
  x-init="$watch('activeTab', value => {
    if (window.location.pathname === '/admin') {
      const url = new URL(window.location);
      url.searchParams.set('tab', value);
      window.history.replaceState({}, '', url);
    }
  })"
>

  <% if (locals.user) { %>
  <!-- Mobile Sidebar Overlay -->
  <div x-show="sidebarOpen" x-transition.opacity class="fixed inset-0 z-20 lg:hidden" 
    style="background-color: rgba(0, 0, 0, 0.4); backdrop-filter: blur(4px);"
    @click="sidebarOpen = false"></div>

  <!-- Sidebar -->
  <aside 
    :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'" 
    class="fixed inset-y-0 left-0 z-30 w-64 bg-white border-r border-gray-100 shadow-xl transition-transform duration-300 transform lg:translate-x-0 lg:static lg:inset-0 flex flex-col">
    
    <div class="flex items-center justify-center h-20 border-b border-gray-100 bg-container bg-opacity-30">
      <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white mr-3 shadow-lg hover:rotate-12 transition-transform duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
        </svg>
      </div>
      <span class="text-2xl font-bold text-gray-900 tracking-tight">LeadHunters</span>
    </div>

    <nav class="flex-1 px-4 py-6 space-y-2 relative">
      <a href="/" class="flex items-center px-4 py-3 rounded-xl transition-all duration-200 group"
         :class="window.location.pathname === '/' ? 'bg-container text-primary' : 'text-gray-600 hover:bg-container hover:text-primary'">
        <svg class="w-5 h-5 mr-3 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span class="font-medium">Dashboard Overview</span>
      </a>
      
      <% if (user.role === 'SUPER_ADMIN') { %>
      <div class="pt-4 pb-2 px-4 shadow-sm">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Management</span>
      </div>

      <a href="/admin?tab=customers" 
         @click.prevent="if(window.location.pathname === '/admin') { activeTab = 'customers'; sidebarOpen = false; } else { window.location.href = '/admin?tab=customers' }"
         class="flex items-center px-4 py-3 rounded-xl transition-all duration-200 group"
         :class="(window.location.pathname === '/admin' && activeTab === 'customers') ? 'bg-container text-primary shadow-sm' : 'text-gray-600 hover:bg-container hover:text-primary'">
        <svg class="w-5 h-5 mr-3 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <span class="font-medium">Customers</span>
      </a>

      <a href="/admin?tab=telecallers" 
         @click.prevent="if(window.location.pathname === '/admin') { activeTab = 'telecallers'; sidebarOpen = false; } else { window.location.href = '/admin?tab=telecallers' }"
         class="flex items-center px-4 py-3 rounded-xl transition-all duration-200 group"
         :class="(window.location.pathname === '/admin' && activeTab === 'telecallers') ? 'bg-container text-primary shadow-sm' : 'text-gray-600 hover:bg-container hover:text-primary'">
        <svg class="w-5 h-5 mr-3 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        <span class="font-medium">Telecallers</span>
      </a>
      <% } %>

      <a href="/logout" class="flex items-center px-4 py-3 text-gray-600 hover:bg-red-50 hover:text-red-700 rounded-xl transition-all duration-200 group mt-auto absolute bottom-8 w-56">
        <svg class="w-5 h-5 mr-3 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        <span class="font-medium">Sign Out</span>
      </a>
    </nav>
  </aside>

  <!-- Main Content Wrapper -->
  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <!-- Mobile Header Bar -->
    <header class="bg-white border-b border-gray-100 lg:hidden flex items-center justify-between px-4 py-3 shadow-sm z-10 sticky top-0">
      <button @click="sidebarOpen = true" class="text-gray-500 hover:text-primary focus:outline-none p-2 rounded-md hover:bg-gray-100 transition-colors">
        <svg fill="currentColor" viewBox="0 0 20 20" class="w-6 h-6">
          <path fill-rule="evenodd" d="M3 5h14a1 1 0 010 2H3a1 1 0 010-2zM3 10h14a1 1 0 010 2H3a1 1 0 010-2zM3 15h14a1 1 0 010 2H3a1 1 0 010-2z" clip-rule="evenodd"></path>
        </svg>
      </button>
      <span class="text-lg font-bold text-gray-900">LeadHunters</span>
      <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center font-bold shadow-md">
        <%= user.name.charAt(0).toUpperCase() %>
      </div>
    </header>
  <% } else { %>
  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
  <% } %>

    <main class="flex-1 overflow-y-auto px-4 sm:px-6 lg:px-8 py-8 w-full max-w-7xl mx-auto">
