<%- include('partials/header') %>

<div class="animate-fade-in-up">
    <!-- Header Section -->
    <div class="mb-8 flex md:flex-row flex-col justify-between md:items-end">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 border-b-4 border-primary inline-block pb-1">Owner Dashboard</h2>
        <p class="text-sm font-medium text-gray-500 mt-2">Welcome back, <%= user.name %></p>
      </div>
    </div>
  <div class="px-4 py-4 sm:px-0">
    <!-- Actions Section -->
    <div x-show="activeTab === 'upload'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 transform translate-y-4" x-transition:enter-end="opacity-100 transform translate-y-0" class="space-y-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Stat Card -->
        <div class="bg-white shadow rounded-2xl border border-gray-100 flex items-center p-6 h-full">
          <div class="p-3 rounded-xl bg-blue-50 text-blue-500 mr-4">
            <svg class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500 truncate">Total Leads</p>
            <p class="mt-1 text-4xl font-semibold text-gray-900"><%= stats.total %></p>
          </div>
        </div>

        <!-- Upload Card -->
        <div class="bg-white shadow rounded-2xl border border-gray-100 p-6 md:col-span-1 lg:col-span-2 h-full">
       <div class="flex justify-between items-center mb-4">
         <h3 class="text-lg leading-6 font-bold text-gray-900">Upload New Leads (CSV/Excel)</h3>
         <a href="/sample_leads.csv" download class="text-sm font-medium text-blue-600 hover:text-blue-500 flex items-center transition-colors">
           <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
           Download Sample
         </a>
       </div>
       <form action="/owner/upload-leads" method="POST" enctype="multipart/form-data" class="flex items-center space-x-4">
         <div class="flex-1">
           <label class="block sr-only">Choose file</label>
           <input type="file" name="leads_file" accept=".csv, .xlsx, .xls" required class="block w-full text-sm text-gray-500
             file:mr-4 file:py-2 file:px-4
             file:rounded-full file:border-0
             file:text-sm file:font-semibold
             file:bg-container file:text-primary
             hover:file:bg-red-100"
           />
         </div>
         <button type="submit" class="btn-primary flex items-center shrink-0">
           <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-2">
             <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
           </svg>
           Upload
         </button>
       </form>
       <div class="mt-4 flex items-center text-xs text-gray-400 font-medium">
         <svg class="w-4 h-4 mr-1.5 text-blue-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
         </svg>
         Supported: .csv, .xlsx, .xls | Required columns: Name, Phone
       </div>
       <% if (locals.uploadMsg) { %>
         <p class="mt-3 text-sm text-green-600 font-bold flex items-center">
            <svg class="w-4 h-4 mr-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <%= uploadMsg %>
         </p>
       <% } %>
       <% if (locals.errorMsg) { %>
         <p class="mt-3 text-sm text-red-600 font-bold flex items-center">
            <svg class="w-5 h-5 mr-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            <%= errorMsg %>
         </p>
       <% } %>
      </div>
    </div> <!-- Close Grid wrapper -->

    <!-- Leads Table -->
    <div class="bg-white shadow rounded-2xl overflow-hidden border border-gray-100">
        <div class="px-6 py-5 border-b border-gray-200 bg-gray-50/50 flex justify-between items-center">
          <h3 class="text-lg leading-6 font-bold text-gray-900">Your Leads</h3>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
            Total: <%= locals.leads ? leads.length : 0 %>
          </span>
        </div>
        
        <div class="overflow-x-auto relative hidden-scrollbar border-t border-gray-100">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm border-b border-gray-200">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Name</th>
                <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Mobile No.</th>
                <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Assigned To</th>
                <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Added On</th>
              </tr>
            </thead>
            <tbody id="leads-table-body" class="bg-white divide-y divide-gray-200">
              <% if (locals.leads && leads.length > 0) { %>
                <% leads.forEach(function(lead) { %>
                  <tr class="lead-row hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900"><%= lead.name %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500 font-medium"><%= lead.phone %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-700">
                      <% if (lead.telecaller) { %>
                        <span class="inline-flex items-center gap-1.5 font-medium">
                          <span class="w-1.5 h-1.5 rounded-full bg-blue-400 shrink-0"></span>
                          <%= lead.telecaller.device_alias || lead.telecaller.name %>
                        </span>
                      <% } else { %>
                        <span class="text-gray-400 italic text-[10px]">Unassigned</span>
                      <% } %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-500 font-medium"><%= new Date(lead.created_at).toLocaleDateString('en-IN') %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr id="leads-empty-state">
                  <td colspan="5" class="px-6 py-12 text-center text-sm text-gray-500 font-medium italic">No leads found.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        
        <!-- Leads Pagination Controls -->
        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex items-center justify-between">
           <div class="text-xs text-gray-500 font-medium" id="leads-pagination-info">
             Showing <span id="leads-start-range">0</span> to <span id="leads-end-range">0</span> of <span id="leads-total-count">0</span> leads
           </div>
           <div class="flex items-center gap-2">
             <button id="leads-prev-page" class="p-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 hover:text-primary hover:border-primary disabled:opacity-30 disabled:hover:text-gray-400 disabled:hover:border-gray-200 transition-all">
               <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
             </button>
             <div id="leads-page-numbers" class="flex items-center gap-1"></div>
             <button id="leads-next-page" class="p-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 hover:text-primary hover:border-primary disabled:opacity-30 disabled:hover:text-gray-400 disabled:hover:border-gray-200 transition-all">
               <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
             </button>
           </div>
        </div>
      </div>

      <!-- Assign Unassigned Leads Panel -->
      <div class="bg-white shadow rounded-2xl border border-gray-100 p-6">
        <div class="flex flex-col sm:flex-row sm:items-end gap-4">
          <div class="flex-1">
            <h3 class="text-base font-bold text-gray-900 mb-1">Assign Unassigned Leads</h3>
            <p class="text-xs text-gray-400 mb-3">Select a telecaller below to assign all currently <span class="font-semibold text-amber-600">unassigned</span> leads to them.</p>
            <label class="block text-xs font-semibold text-gray-500 mb-1">Select Telecaller <span class="text-red-500">*</span></label>
            <form action="/owner/assign-leads" method="POST" class="flex items-center gap-6">
              <select name="telecaller_id" required
                class="flex-1 block rounded-xl border border-gray-200 bg-gray-50 text-sm text-gray-700 py-2 px-3 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all">
                <option value="">— Select a Telecaller —</option>
                <% if (locals.telecallers && telecallers.length > 0) { %>
                  <% telecallers.forEach(function(tc) { %>
                    <option value="<%= tc.id %>"><%= tc.name %></option>
                  <% }); %>
                <% } else { %>
                  <option disabled>No telecallers assigned to you yet</option>
                <% } %>
              </select>
              <button type="submit" class="btn-primary flex items-center shrink-0">
                <svg class="w-4 h-4 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Assign All Unassigned
              </button>
            </form>
          </div>
        </div>

        <!-- Assign feedback messages -->
        <% if (locals.assignMsg) { %>
          <p class="mt-4 text-sm text-green-600 font-bold flex items-center">
            <svg class="w-4 h-4 mr-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <%= assignMsg %>
          </p>
        <% } %>
        <% if (locals.assignError) { %>
          <p class="mt-4 text-sm text-red-600 font-bold flex items-center">
            <svg class="w-5 h-5 mr-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            <%= assignError %>
          </p>
        <% } %>
      </div>
      
    </div>

    <!-- Detailed View Feed -->
    <div x-cloak x-show="activeTab === 'activity'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 transform translate-y-4" x-transition:enter-end="opacity-100 transform translate-y-0" class="bg-white shadow rounded-2xl overflow-hidden border border-gray-100">
      <div class="px-6 py-5 border-b border-gray-200 bg-gray-50/50 flex justify-between items-center">
        <h3 class="text-lg leading-6 font-bold text-gray-900">Detailed View</h3>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
          <span class="w-2 h-2 mr-1.5 bg-green-500 rounded-full animate-pulse"></span>
          Live
        </span>
      </div>

      <!-- Live Activity Stats -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 px-6 py-4 bg-gray-50/30 border-b border-gray-100">
        <div class="bg-white overflow-hidden shadow-sm hover:shadow rounded-lg p-3 border border-gray-100 flex items-center transition-all duration-200">
          <div class="p-2 rounded-lg bg-amber-50 text-amber-500 mr-4">
            <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500 truncate">Pending Calls</p>
            <p class="mt-1 text-2xl md:text-3xl font-semibold text-gray-900" id="stat-pending"><%= stats.pending %></p>
          </div>
        </div>

        <div class="bg-white overflow-hidden shadow-sm hover:shadow rounded-lg p-3 border border-gray-100 flex items-center transition-all duration-200">
          <div class="p-2 rounded-lg bg-green-50 text-emerald-500 mr-4">
            <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500 truncate">Answered</p>
            <p class="mt-1 text-2xl md:text-3xl font-semibold text-gray-900" id="stat-answered"><%= stats.answered %></p>
          </div>
        </div>
      </div>
       <div class="overflow-x-auto relative hidden-scrollbar border-t border-gray-100">
           <table class="min-w-full divide-y divide-gray-200">
             <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm border-b border-gray-200">
               <tr>
                 <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Customer Name</th>
                 <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Mobile</th>
                 <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Timestamp</th>
                 <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Duration</th>
                 <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Outcome</th>
                 <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Call Status</th>
                 <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Remarks</th>
                 <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Telecaller</th>
                 <th scope="col" class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Recording</th>
               </tr>
             </thead>
             <tbody id="live-calls" class="bg-white divide-y divide-gray-200">
               <% if (locals.callLogs && callLogs.length > 0) { %>
                 <% callLogs.forEach(function(log) { %>
                   <tr id="log-<%= log.id %>" class="log-row hover:bg-gray-50 transition-colors animate-fade-in-up">
                     <td class="px-6 py-4 whitespace-nowrap">
                       <div class="text-sm font-bold text-gray-900"><%= log.lead.name %></div>
                     </td>
                     <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500 font-medium"><%= log.lead.phone %></td>
                     <td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-500 font-medium">
                        <%= new Date(log.created_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', hour12: true }) %>
                     </td>
                     <td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-700 font-bold">
                        <% 
                          const mins = Math.floor(log.duration_seconds / 60);
                          const secs = log.duration_seconds % 60;
                          const formattedDuration = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                        %>
                        <%= formattedDuration %>
                     </td>
                     <td class="px-6 py-4 whitespace-nowrap">
                        <% 
                          let outcomeStatus = log.outcome && log.outcome !== 'PENDING' ? log.outcome : '—';
                          let leadStatusClass = 'bg-gray-100 text-gray-800';
                          if (outcomeStatus === '—') leadStatusClass = 'bg-gray-100 text-gray-400';
                          else if (['ANSWERED', 'INTERESTED', 'ORDERED', 'BOOKED'].includes(outcomeStatus)) leadStatusClass = 'bg-green-100 text-green-800';
                          else if (['LOST', 'REJECTED', 'CANCELLED', 'MISSED', 'BUSY'].includes(outcomeStatus)) leadStatusClass = 'bg-red-100 text-red-800';
                          else if (outcomeStatus === 'REMIND_LATER') leadStatusClass = 'bg-blue-100 text-blue-800';
                        %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider <%= leadStatusClass %>">
                          <%= outcomeStatus %>
                        </span>
                     </td>
                     <td class="px-6 py-4 whitespace-nowrap">
                       <div class="text-sm font-bold text-gray-900 uppercase"><%= log.call_status %></div>
                     </td>
                     <td class="px-6 py-4">
                       <div class="text-[11px] text-gray-600 italic max-w-xs truncate" title="<%= log.notes %>">
                         <%= log.notes || '—' %>
                       </div>
                     </td>
                     <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-xs font-medium text-gray-700">
                          <%= log.telecaller.device_alias || log.telecaller.name %>
                        </div>
                     </td>
                     <td class="px-6 py-4 whitespace-nowrap">
                        <div class="audio-container">
                          <% if (log.recording_url) { %>
                             <audio controls src="<%= log.recording_url %>" class="h-6 w-32 outline-none"></audio>
                          <% } %>
                        </div>
                     </td>
                   </tr>
                 <% }); %>
               <% } else { %>
                 <tr id="empty-state">
                   <td colspan="9" class="px-6 py-12 text-center text-sm text-gray-500 font-medium italic">
                      <div class="flex flex-col items-center">
                        <svg class="w-12 h-12 text-gray-200 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>Waiting for fresh call logs via Socket...</span>
                      </div>
                   </td>
                 </tr>
               <% } %>
             </tbody>
           </table>
       </div>
       
       <!-- Pagination Controls -->
       <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex items-center justify-between">
          <div class="text-xs text-gray-500 font-medium" id="pagination-info">
            Showing <span id="start-range">0</span> to <span id="end-range">0</span> of <span id="total-count">0</span> logs
          </div>
          <div class="flex items-center gap-2">
            <button id="prev-page" class="p-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 hover:text-primary hover:border-primary disabled:opacity-30 disabled:hover:text-gray-400 disabled:hover:border-gray-200 transition-all">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <div id="page-numbers" class="flex items-center gap-1">
              <!-- JS will inject page numbers here -->
            </div>
            <button id="next-page" class="p-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 hover:text-primary hover:border-primary disabled:opacity-30 disabled:hover:text-gray-400 disabled:hover:border-gray-200 transition-all">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </button>
          </div>
       </div>
    </div>
  </div>
</div>

<script>
  let currentPage = 1;
  let leadsPage = 1;
  const rowsPerPage = 5;

  function formatDuration(totalSeconds) {
    const mins = Math.floor(totalSeconds / 60);
    const secs = totalSeconds % 60;
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  }

  function getStatusBadge(status) {
    let badgeClass = 'bg-gray-100 text-gray-800';
    if (status === '—' || !status) return `<span class="inline-flex items-center px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-gray-100 text-gray-400">—</span>`;
    
    if (['ANSWERED', 'INTERESTED', 'ORDERED', 'BOOKED'].includes(status)) badgeClass = 'bg-green-100 text-green-800';
    else if (['LOST', 'REJECTED', 'CANCELLED', 'MISSED', 'BUSY'].includes(status)) badgeClass = 'bg-red-100 text-red-800';
    else if (status === 'REMIND_LATER') badgeClass = 'bg-blue-100 text-blue-800';
    else if (status === 'PENDING') badgeClass = 'bg-amber-100 text-amber-800';
    
    return `<span class="inline-flex items-center px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider ${badgeClass}">${status}</span>`;
  }

  function updatePagination() {
    const tbody = document.getElementById('live-calls');
    if (!tbody) return;
    
    const rows = Array.from(tbody.querySelectorAll('tr:not(#empty-state)'));
    const totalCount = rows.length;
    const totalPages = Math.ceil(totalCount / rowsPerPage) || 1;

    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const start = (currentPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;

    rows.forEach((row, index) => {
      row.style.display = (index >= start && index < end) ? '' : 'none';
    });

    if (document.getElementById('start-range')) document.getElementById('start-range').innerText = totalCount === 0 ? 0 : start + 1;
    if (document.getElementById('end-range')) document.getElementById('end-range').innerText = Math.min(end, totalCount);
    if (document.getElementById('total-count')) document.getElementById('total-count').innerText = totalCount;

    if (document.getElementById('prev-page')) document.getElementById('prev-page').disabled = currentPage === 1;
    if (document.getElementById('next-page')) document.getElementById('next-page').disabled = currentPage === totalPages;

    const pageContainer = document.getElementById('page-numbers');
    if (pageContainer) {
        pageContainer.innerHTML = '';
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
        for (let i = startPage; i <= endPage; i++) {
          const btn = document.createElement('button');
          btn.className = `w-8 h-8 rounded-lg text-xs font-bold transition-all ${i === currentPage ? 'bg-primary text-white' : 'bg-white text-gray-500 hover:bg-gray-100'}`;
          btn.innerText = i;
          btn.onclick = () => { currentPage = i; updatePagination(); };
          pageContainer.appendChild(btn);
        }
    }
  }

  function updateLeadsPagination() {
    const tbody = document.getElementById('leads-table-body');
    if (!tbody) return;
    
    const rows = Array.from(tbody.querySelectorAll('.lead-row'));
    const totalCount = rows.length;
    const totalPages = Math.ceil(totalCount / rowsPerPage) || 1;

    if (leadsPage > totalPages) leadsPage = totalPages;
    if (leadsPage < 1) leadsPage = 1;

    const start = (leadsPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;

    rows.forEach((row, index) => {
      row.style.display = (index >= start && index < end) ? '' : 'none';
    });

    if (document.getElementById('leads-start-range')) document.getElementById('leads-start-range').innerText = totalCount === 0 ? 0 : start + 1;
    if (document.getElementById('leads-end-range')) document.getElementById('leads-end-range').innerText = Math.min(end, totalCount);
    if (document.getElementById('leads-total-count')) document.getElementById('leads-total-count').innerText = totalCount;

    if (document.getElementById('leads-prev-page')) document.getElementById('leads-prev-page').disabled = leadsPage === 1;
    if (document.getElementById('leads-next-page')) document.getElementById('leads-next-page').disabled = leadsPage === totalPages;

    const pageContainer = document.getElementById('leads-page-numbers');
    if (pageContainer) {
        pageContainer.innerHTML = '';
        let startPage = Math.max(1, leadsPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
        for (let i = startPage; i <= endPage; i++) {
          const btn = document.createElement('button');
          btn.className = `w-8 h-8 rounded-lg text-xs font-bold transition-all ${i === leadsPage ? 'bg-primary text-white' : 'bg-white text-gray-500 hover:bg-gray-100'}`;
          btn.innerText = i;
          btn.onclick = () => { leadsPage = i; updateLeadsPagination(); };
          pageContainer.appendChild(btn);
        }
    }
  }

  document.getElementById('prev-page').onclick = () => { if (currentPage > 1) { currentPage--; updatePagination(); } };
  document.getElementById('next-page').onclick = () => { currentPage++; updatePagination(); };

  document.getElementById('leads-prev-page').onclick = () => { if (leadsPage > 1) { leadsPage--; updateLeadsPagination(); } };
  document.getElementById('leads-next-page').onclick = () => { leadsPage++; updateLeadsPagination(); };

  // Initial Pagination
  updatePagination();
  updateLeadsPagination();

  socket.emit('join_dashboard', '<%= user.id %>');

  socket.on('new_call_log', (data) => {
    const list = document.getElementById('live-calls');
    const emptyState = document.getElementById('empty-state');
    if (emptyState) emptyState.remove();

    // Update Answered Stat if call was successful
    if(data.call_status === 'ANSWERED') {
      const ansEl = document.getElementById('stat-answered');
      if(ansEl) ansEl.innerText = parseInt(ansEl.innerText) + 1;
    }

    // Decrement Pending Stat if an outcome was decided
    if(data.outcome && data.outcome !== '—') {
      const pendEl = document.getElementById('stat-pending');
      // Note: This is an approximation since we don't know the previous status via socket
      if(pendEl && parseInt(pendEl.innerText) > 0) pendEl.innerText = parseInt(pendEl.innerText) - 1;
    }

    const tr = document.createElement('tr');
    tr.id = `log-${data.log_id}`;
    tr.className = "log-row hover:bg-gray-50 transition-colors animate-fade-in-up";
    
    const timestamp = new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', hour12: true });

    tr.innerHTML = `
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm font-bold text-gray-900">${data.lead_name}</div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500 font-medium">${data.lead_phone}</td>
      <td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-500 font-medium">${timestamp}</td>
      <td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-700 font-bold">${formatDuration(data.duration)}</td>
      <td class="px-6 py-4 whitespace-nowrap lead-status-cell">${getStatusBadge(data.outcome && data.outcome !== 'PENDING' ? data.outcome : '—')}</td>
      <td class="px-6 py-4 whitespace-nowrap">
         <div class="text-sm font-bold text-gray-900 uppercase">${data.call_status}</div>
      </td>
      <td class="px-6 py-4">
        <div class="text-[11px] text-gray-600 italic max-w-xs truncate" title="${data.notes || ''}">${data.notes || '—'}</div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-xs font-medium text-gray-700">${data.telecaller_name}</div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
         <div class="audio-container"></div>
      </td>
    `;
    
    list.prepend(tr);
    
    // Update pagination to reflect new row
    updatePagination();
  });

  socket.on('recording_ready', (data) => {
    const logItem = document.getElementById(`log-${data.log_id}`);
    if (logItem) {
      const container = logItem.querySelector('.audio-container');
      if (container && !container.querySelector('audio')) {
        const audio = document.createElement('audio');
        audio.controls = true;
        audio.src = data.recording_url;
        audio.className = "h-6 w-32 outline-none";
        container.appendChild(audio);
      }
    }
  });
</script>

