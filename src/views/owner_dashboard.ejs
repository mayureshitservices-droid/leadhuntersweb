                Cancel
            </button>
            <button onclick="confirmDeleteCampaign()" 
                    class="flex-1 px-6 py-4 rounded-2xl bg-primary text-sm font-bold text-white hover:bg-red-700 shadow-lg shadow-red-200 transition-all">
                Delete Leads
            </button>
        </div>
    </div>
</div>

