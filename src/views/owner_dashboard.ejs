<%- include('partials/header') %>

<div class="animate-fade-in-up">
    <!-- Header Section -->
    <div class="mb-8 flex md:flex-row flex-col justify-between md:items-end px-2 sm:px-0">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 border-b-4 border-primary inline-block pb-1">Owner Dashboard</h2>
        <p class="text-sm font-medium text-gray-500 mt-2">Welcome back, <%= user.name %></p>
      </div>
    </div>
  <div class="px-0 py-4 sm:px-0">
    <!-- Actions Section -->
    <div x-show="activeTab === 'upload'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 transform translate-y-4" x-transition:enter-end="opacity-100 transform translate-y-0" class="space-y-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Stat Card -->
        <div class="bg-white shadow rounded-2xl border border-gray-100 flex items-center p-6 h-full">
          <div class="p-3 rounded-xl bg-blue-50 text-blue-500 mr-4">
            <svg class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500 truncate">Total Leads</p>
            <p class="mt-1 text-4xl font-semibold text-gray-900"><%= stats.total %></p>
          </div>
        </div>

        <!-- Upload Card -->
        <div class="bg-white shadow rounded-2xl border border-gray-100 p-6 md:col-span-1 lg:col-span-2 h-full">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg leading-6 font-bold text-gray-900">Upload New Leads (CSV/Excel)</h3>
          <a href="/sample_leads.csv" download class="text-sm font-medium text-blue-600 hover:text-blue-500 flex items-center transition-colors">
            <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Download Sample
          </a>
        </div>
        <form action="/owner/upload-leads" method="POST" enctype="multipart/form-data" class="flex items-center space-x-4">
          <div class="flex-1">
            <input type="file" name="leads_file" accept=".csv, .xlsx, .xls" required class="block w-full text-sm text-gray-500
              file:mr-4 file:py-2 file:px-4
              file:rounded-full file:border-0
              file:text-sm file:font-semibold
              file:bg-container file:text-primary
              hover:file:bg-red-100"
            />
          </div>
          <button type="submit" class="btn-primary flex items-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
            </svg>
            Upload
          </button>
        </form>
        </div>
      </div>

      <!-- Leads Table -->
      <div class="bg-white shadow rounded-2xl overflow-hidden border border-gray-100">
          <div class="px-6 py-5 border-b border-gray-200 bg-gray-50/50 flex justify-between items-center">
            <h3 class="text-lg leading-6 font-bold text-gray-900">Your Leads</h3>
          </div>
          
          <div class="overflow-x-auto relative hidden-scrollbar border-t border-gray-100 hidden md:block">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm border-b border-gray-200">
                <tr>
                  <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Name</th>
                  <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Mobile</th>
                  <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Assigned To</th>
                  <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Added On</th>
                </tr>
              </thead>
              <tbody id="leads-table-body" class="bg-white divide-y divide-gray-200">
                <% if (locals.leads && leads.length > 0) { %>
                  <% leads.forEach(function(lead) { %>
                    <tr class="lead-row hover:bg-gray-50 transition-colors">
                      <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900"><%= lead.name %></td>
                      <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500 font-medium"><%= lead.phone %></td>
                      <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-700">
                        <% if (lead.telecaller) { %>
                          <span class="inline-flex items-center gap-1.5 font-medium"><span class="w-1.5 h-1.5 rounded-full bg-blue-400 shrink-0"></span><%= lead.telecaller.device_alias || lead.telecaller.name %></span>
                        <% } else { %>
                          <span class="text-gray-400 italic text-[10px]">Unassigned</span>
                        <% } %>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-500 font-medium"><%= new Date(lead.created_at).toLocaleDateString('en-IN') %></td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Mobile Card View (Leads) -->
          <div id="leads-cards-container" class="md:hidden divide-y divide-gray-100">
             <% if (locals.leads && leads.length > 0) { %>
               <% leads.forEach(function(lead) { %>
                 <div class="lead-card p-5 hover:bg-gray-50 transition-colors">
                   <div class="flex justify-between items-start">
                     <div>
                       <h4 class="text-base font-bold text-gray-900"><%= lead.name %></h4>
                       <p class="text-sm text-gray-500 font-medium mt-1"><%= lead.phone %></p>
                     </div>
                     <% if (lead.telecaller) { %>
                       <span class="text-[10px] bg-blue-50 text-blue-600 px-2.5 py-1 rounded-full font-bold uppercase tracking-wider"><%= lead.telecaller.device_alias || lead.telecaller.name %></span>
                     <% } %>
                   </div>
                 </div>
               <% }); %>
             <% } %>
          </div>
          
          <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
             <div class="flex flex-col sm:flex-row gap-4 items-center justify-between">
                <div class="text-xs text-gray-500 font-medium" id="leads-pagination-info">
                  Showing <span id="leads-start-range">0</span> to <span id="leads-end-range">0</span> of <span id="leads-total-count">0</span> leads
                </div>
                <div class="hidden md:flex items-center gap-2">
                  <button id="leads-prev-page" class="p-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 hover:text-primary disabled:opacity-30 transition-all"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg></button>
                  <div id="leads-page-numbers" class="flex items-center gap-1"></div>
                  <button id="leads-next-page" class="p-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 hover:text-primary disabled:opacity-30 transition-all"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></button>
                </div>
                <button id="leads-load-more" class="md:hidden w-full py-3 rounded-2xl border-2 border-gray-100 bg-white text-xs font-bold text-gray-600 shadow-sm transition-all">Load More Leads</button>
             </div>
          </div>
      </div>
    </div>

    <!-- Detailed View Feed -->
    <div x-cloak x-show="activeTab === 'activity'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 transform translate-y-4" x-transition:enter-end="opacity-100 transform translate-y-0" class="md:bg-white md:shadow md:rounded-2xl overflow-hidden md:border md:border-gray-100">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50/50 flex justify-between items-center hidden md:flex">
        <h3 class="text-lg leading-6 font-bold text-gray-900">Detailed View</h3>
      </div>

       <div class="overflow-x-auto relative hidden-scrollbar border-t border-gray-100 hidden md:block">
           <table class="min-w-full divide-y divide-gray-200">
             <!-- ... table header ... -->
             <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm border-b border-gray-200">
               <tr>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Customer Name</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Mobile</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Timestamp</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Duration</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Status</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Outcome</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Remarks</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Telecaller</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Recording</th>
               </tr>
             </thead>
             <tbody id="live-calls" class="bg-white divide-y divide-gray-200">
               <% if (locals.callLogs && callLogs.length > 0) { %>
                 <% callLogs.forEach(function(log) { %>
                   <tr id="log-<%= log.id %>" class="log-row hover:bg-gray-50 transition-colors animate-fade-in-up">
                     <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900"><%= log.lead.name %></td>
                     <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500 font-medium"><%= log.lead.phone %></td>
                     <td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-500 font-medium"><%= new Date(log.created_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', hour12: true }) %></td>
                     <td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-700 font-bold"><%= Math.floor(log.duration_seconds / 60).toString().padStart(2, '0') %>:<%= (log.duration_seconds % 60).toString().padStart(2, '0') %></td>
                     <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900 capitalize"><%= log.call_status ? log.call_status.toLowerCase() : '' %></td>
                     <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900 capitalize"><%= (log.outcome && log.outcome !== 'PENDING' ? log.outcome : '—').toLowerCase().replace(/_/g, ' ') %></td>
                     <td class="px-6 py-4"><div class="text-[11px] text-gray-600 italic max-w-xs truncate" title="<%= log.notes %>"><%= log.notes || '—' %></div></td>
                     <td class="px-6 py-4 whitespace-nowrap text-xs font-medium text-gray-700"><%= log.telecaller.device_alias || log.telecaller.name %></td>
                     <td class="px-6 py-4 whitespace-nowrap"><div class="audio-container"><% if (log.recording_url) { %><audio controls src="<%= log.recording_url %>" class="h-6 w-32 outline-none"></audio><% } %></div></td>
                   </tr>
                 <% }); %>
               <% } %>
             </tbody>
           </table>
       </div>

       <!-- Mobile Card View (Premium - Optimized Space) -->
       <div id="activity-cards-container" class="md:hidden pb-12">
          <% if (locals.callLogs && callLogs.length > 0) { 
               let lastDate = "";
               callLogs.forEach(function(log) { 
                 const logDate = new Date(log.created_at).toLocaleDateString('en-IN', { day:'2-digit', month:'long', year:'numeric' });
                 if (logDate !== lastDate) { lastDate = logDate; %>
             <div class="date-header px-4 py-2 bg-white/95 backdrop-blur-md text-[9px] font-bold text-gray-400 sticky top-0 z-10 border-b border-gray-100 uppercase tracking-[0.2em] mb-4"><%= logDate %></div>
          <% } %>
             <div id="card-log-<%= log.id %>" class="activity-card bg-white p-4 mb-5 shadow-[0_12px_40px_rgba(0,0,0,0.12)] border border-gray-100 rounded-2xl mx-0 animate-fade-in-up">
                <!-- Header: Info (No redundant badge) -->
                <div class="mb-3">
                  <h4 class="text-lg font-bold text-gray-900 leading-tight tracking-tight"><%= log.lead.name %></h4>
                  <p class="text-sm text-gray-500 font-bold mt-0.5 tracking-tight"><%= log.lead.phone %></p>
                </div>

                <!-- Stats Row (Compact) -->
                <div class="grid grid-cols-3 gap-0.5 py-3 border-y border-gray-100 mb-3">
                  <div class="flex flex-col items-center text-center">
                    <p class="text-[10px] text-gray-400 font-bold uppercase tracking-wide mb-1">Time</p>
                    <p class="text-sm text-gray-800 font-bold"><%= new Date(log.created_at).toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit', hour12: true }) %></p>
                  </div>
                  <div class="flex flex-col items-center text-center border-x border-gray-100 px-1">
                    <p class="text-[10px] text-gray-400 font-bold uppercase tracking-wide mb-1">Duration</p>
                    <p class="text-sm text-gray-800 font-bold"><%= Math.floor(log.duration_seconds / 60).toString().padStart(2, '0') %>:<%= (log.duration_seconds % 60).toString().padStart(2, '0') %></p>
                  </div>
                  <div class="flex flex-col items-center text-center">
                    <p class="text-[10px] text-gray-400 font-bold uppercase tracking-wide mb-1">Status</p>
                    <p class="text-sm text-emerald-600 font-bold uppercase tracking-wide"><%= log.call_status ? log.call_status.toLowerCase() : 'Answered' %></p>
                  </div>
                </div>

                <!-- Remarks Section (Reduced Height) -->
                <% if (log.notes) { %>
                  <div class="flex gap-3 mb-4 px-1">
                    <div class="text-primary opacity-30 shrink-0">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H16.017C14.9124 8 14.017 7.10457 14.017 6V5C14.017 3.89543 14.9124 3 16.017 3H19.017C21.2261 3 23.017 4.79086 23.017 7V15C23.017 18.3137 20.3307 21 17.017 21H14.017ZM1.017 21L1.017 18C1.017 16.8954 1.91243 16 3.017 16H6.017C6.56928 16 7.017 15.5523 7.017 15V9C7.017 8.44772 6.56928 8 6.017 8H3.017C1.91243 8 1.017 7.10457 1.017 6V5C1.017 3.89543 1.91243 3 3.017 3H6.017C8.22614 3 10.017 4.79086 10.017 7V15C10.017 18.3137 7.33072 21 4.017 21H1.017Z"/></svg>
                    </div>
                    <p class="text-sm text-gray-700 font-medium leading-relaxed italic line-clamp-3"><%= log.notes %></p>
                  </div>
                <% } %>

                <div class="h-px bg-gray-50 mb-4"></div>

                <!-- Footer Row (Compact) -->
                <div class="flex items-center justify-between mb-3 px-1">
                  <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-green-50 text-emerald-600 border border-emerald-100 font-bold text-xs shadow-sm">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.382-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
                    <%= (log.outcome && log.outcome !== 'PENDING' ? log.outcome : 'Interested').toLowerCase().replace(/_/g, ' ') %>
                  </div>
                  <div class="flex items-center gap-1.5 text-gray-400">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    <span class="text-xs font-bold text-gray-500 uppercase tracking-tight"><%= log.telecaller.device_alias || log.telecaller.name %></span>
                  </div>
                </div>

                <!-- Audio Player row (Explicit Visibility) -->
                <div class="audio-container w-full pt-1">
                   <% if (log.recording_url) { %>
                     <audio controls src="<%= log.recording_url %>" class="h-10 w-full outline-none bg-gray-50 rounded-xl"></audio>
                   <% } else { %>
                     <div class="h-10 w-full bg-gray-50 rounded-xl flex items-center justify-center border border-dashed border-gray-200">
                        <span class="text-xs text-gray-400 font-medium italic">Recording pending sync</span>
                     </div>
                   <% } %>
                </div>
             </div>

          <% }); } %>
       </div>
       
       <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
          <div class="flex flex-col sm:flex-row gap-4 items-center justify-between">
             <div class="text-xs text-gray-500 font-medium" id="pagination-info">Showing <span id="start-range">0</span> to <span id="end-range">0</span> of <span id="total-count">0</span> logs</div>
             <div class="hidden md:flex items-center gap-2">
               <button id="prev-page" class="p-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 hover:text-primary transition-all"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg></button>
               <div id="page-numbers" class="flex items-center gap-1"></div>
               <button id="next-page" class="p-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 hover:text-primary transition-all"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></button>
             </div>
             <div class="md:hidden w-full"><button id="activity-load-more" class="w-full py-3 rounded-2xl border-2 border-gray-100 bg-white text-xs font-bold text-gray-500 hover:border-primary hover:text-primary shadow-sm">Load More Activity</button></div>
          </div>
       </div>
    </div>
  </div>
</div>

<script>
  let currentPage = 1;
  let leadsPage = 1;
  const rowsPerPage = 5;
  const mobilePerPage = 5;
  let currentMobilePage = 1;
  let currentLeadsMobilePage = 1;

  function formatDuration(totalSeconds) {
    const mins = Math.floor(totalSeconds / 60);
    const secs = totalSeconds % 60;
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  }

  function updatePagination() {
    const tbody = document.getElementById('live-calls');
    const mobileContainer = document.getElementById('activity-cards-container');
    if (!tbody || !mobileContainer) return;
    const rows = Array.from(tbody.querySelectorAll('tr:not(#empty-state)'));
    const totalCount = rows.length;
    const totalPages = Math.ceil(totalCount / rowsPerPage) || 1;
    if (currentPage > totalPages) currentPage = totalPages;
    const start = (currentPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;
    rows.forEach((row, index) => { row.style.display = (index >= start && index < end) ? '' : 'none'; });
    const cards = Array.from(mobileContainer.querySelectorAll('.activity-card'));
    const mobileEnd = currentMobilePage * mobilePerPage;
    cards.forEach((card, index) => { card.style.display = index < mobileEnd ? '' : 'none'; });
    const headers = Array.from(mobileContainer.querySelectorAll('.date-header'));
    headers.forEach(header => {
       let next = header.nextElementSibling;
       let hasVisible = false;
       while(next && next.classList.contains('activity-card')) {
          if(next.style.display !== 'none') { hasVisible = true; break; }
          next = next.nextElementSibling;
       }
       header.style.display = hasVisible ? '' : 'none';
    });
    const loadMoreBtn = document.getElementById('activity-load-more');
    if(loadMoreBtn) loadMoreBtn.style.display = mobileEnd >= cards.length ? 'none' : '';
    if (document.getElementById('start-range')) document.getElementById('start-range').innerText = totalCount === 0 ? 0 : start + 1;
    if (document.getElementById('end-range')) document.getElementById('end-range').innerText = Math.min(end, totalCount);
    if (document.getElementById('total-count')) document.getElementById('total-count').innerText = totalCount;
    if (document.getElementById('prev-page')) document.getElementById('prev-page').disabled = currentPage === 1;
    if (document.getElementById('next-page')) document.getElementById('next-page').disabled = currentPage === totalPages;
    const pageContainer = document.getElementById('page-numbers');
    if (pageContainer) {
        pageContainer.innerHTML = '';
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        for (let i = startPage; i <= endPage; i++) {
          const btn = document.createElement('button');
          btn.className = `w-8 h-8 rounded-lg text-xs font-bold ${i === currentPage ? 'bg-primary text-white' : 'bg-white text-gray-500 hover:bg-gray-100'}`;
          btn.innerText = i;
          btn.onclick = () => { currentPage = i; updatePagination(); };
          pageContainer.appendChild(btn);
        }
    }
  }

  function updateLeadsPagination() {
    const tbody = document.getElementById('leads-table-body');
    const mobileContainer = document.getElementById('leads-cards-container');
    if (!tbody || !mobileContainer) return;
    const rows = Array.from(tbody.querySelectorAll('.lead-row'));
    const totalCount = rows.length;
    const totalPages = Math.ceil(totalCount / rowsPerPage) || 1;
    const start = (leadsPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;
    rows.forEach((row, index) => { row.style.display = (index >= start && index < end) ? '' : 'none'; });
    const cards = Array.from(mobileContainer.querySelectorAll('.lead-card'));
    const mobileEnd = currentLeadsMobilePage * mobilePerPage;
    cards.forEach((card, index) => { card.style.display = index < mobileEnd ? '' : 'none'; });
    const loadMoreBtn = document.getElementById('leads-load-more');
    if(loadMoreBtn) loadMoreBtn.style.display = mobileEnd >= cards.length ? 'none' : '';
    if (document.getElementById('leads-start-range')) document.getElementById('leads-start-range').innerText = totalCount === 0 ? 0 : start + 1;
    if (document.getElementById('leads-end-range')) document.getElementById('leads-end-range').innerText = Math.min(end, totalCount);
    if (document.getElementById('leads-total-count')) document.getElementById('leads-total-count').innerText = totalCount;
    if (document.getElementById('leads-prev-page')) document.getElementById('leads-prev-page').disabled = leadsPage === 1;
    if (document.getElementById('leads-next-page')) document.getElementById('leads-next-page').disabled = leadsPage === totalPages;
    const pageContainer = document.getElementById('leads-page-numbers');
    if (pageContainer) {
        pageContainer.innerHTML = '';
        let startPage = Math.max(1, leadsPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        for (let i = startPage; i <= endPage; i++) {
          const btn = document.createElement('button');
          btn.className = `w-8 h-8 rounded-lg text-xs font-bold ${i === leadsPage ? 'bg-primary text-white' : 'bg-white text-gray-500 hover:bg-gray-100'}`;
          btn.innerText = i;
          btn.onclick = () => { leadsPage = i; updateLeadsPagination(); };
          pageContainer.appendChild(btn);
        }
    }
  }

  document.getElementById('prev-page').onclick = () => { if (currentPage > 1) { currentPage--; updatePagination(); } };
  document.getElementById('next-page').onclick = () => { currentPage++; updatePagination(); };
  document.getElementById('activity-load-more').onclick = () => { currentMobilePage++; updatePagination(); };
  document.getElementById('leads-prev-page').onclick = () => { if (leadsPage > 1) { leadsPage--; updateLeadsPagination(); } };
  document.getElementById('leads-next-page').onclick = () => { leadsPage++; updateLeadsPagination(); };
  document.getElementById('leads-load-more').onclick = () => { currentLeadsMobilePage++; updateLeadsPagination(); };

  updatePagination();
  updateLeadsPagination();

  socket.emit('join_dashboard', '<%= user.id %>');
  socket.on('new_call_log', (data) => {
    const list = document.getElementById('live-calls');
    const cardList = document.getElementById('activity-cards-container');
    const existingRow = document.getElementById(`log-${data.log_id}`);
    const existingCard = document.getElementById(`card-log-${data.log_id}`);
    const outcomeText = data.outcome && data.outcome !== 'PENDING' ? data.outcome.toLowerCase().replace(/_/g, ' ') : 'Interested';
    
    if (existingRow) {
      const cells = existingRow.querySelectorAll('td');
      if (cells[5]) cells[5].innerText = outcomeText;
      if (cells[6]) cells[6].innerText = data.notes || '—';
      if(existingCard) {
         const badge = existingCard.querySelector('.activity-card .bg-green-50.text-emerald-600.font-bold');
         const notesDiv = existingCard.querySelector('.activity-card p.italic');
         if(badge) { 
           badge.innerHTML = `<svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.382-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg> ${outcomeText}`;
         }
         if(notesDiv) notesDiv.innerText = data.notes;
      }
      return;
    }

    const tr = document.createElement('tr');
    tr.id = `log-${data.log_id}`;
    tr.className = "log-row hover:bg-gray-50 transition-colors animate-fade-in-up";
    const ts = new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', hour12: true });
    tr.innerHTML = `<td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900">${data.lead_name}</td><td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500 font-medium">${data.lead_phone}</td><td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-500 font-medium">${ts}</td><td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-700 font-bold">${formatDuration(data.duration)}</td><td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900 capitalize">${data.call_status ? data.call_status.toLowerCase() : ''}</td><td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900 capitalize">${outcomeText}</td><td class="px-6 py-4 text-[11px] text-gray-600 italic max-w-xs truncate">${data.notes || '—'}</td><td class="px-6 py-4 whitespace-nowrap text-xs font-medium text-gray-700">${data.telecaller_name}</td><td class="px-6 py-4 whitespace-nowrap"><div class="audio-container"></div></td>`;
    list.prepend(tr);

    const today = new Date().toLocaleDateString('en-IN', { day:'2-digit', month:'long', year:'numeric' });
    let todayHeader = Array.from(cardList.querySelectorAll('.date-header')).find(h => h.innerText.trim() === today);
    if(!todayHeader) {
       todayHeader = document.createElement('div');
       todayHeader.className = "date-header px-4 py-2 bg-white/95 backdrop-blur-md text-[9px] font-bold text-gray-400 sticky top-0 z-10 border-b border-gray-100 uppercase tracking-[0.2em] mb-2";
       todayHeader.innerText = today;
       cardList.prepend(todayHeader);
    }

    const card = document.createElement('div');
    card.id = `card-log-${data.log_id}`;
    card.className = "activity-card bg-white p-4 mb-5 shadow-[0_12px_40px_rgba(0,0,0,0.12)] border border-gray-100 rounded-2xl mx-0 animate-fade-in-up";
    const timeStr = new Date().toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit', hour12: true });
    
    card.innerHTML = `
      <div class="mb-3">
        <h4 class="text-lg font-bold text-gray-900 leading-tight tracking-tight">${data.lead_name}</h4>
        <p class="text-sm text-gray-500 font-bold mt-0.5 tracking-tight">${data.lead_phone}</p>
      </div>
      <div class="grid grid-cols-3 gap-0.5 py-3 border-y border-gray-100 mb-3">
        <div class="flex flex-col items-center text-center"><p class="text-[10px] text-gray-400 font-bold uppercase tracking-wide mb-1">Time</p><p class="text-sm text-gray-800 font-bold">${timeStr}</p></div>
        <div class="flex flex-col items-center text-center border-x border-gray-100 px-1"><p class="text-[10px] text-gray-400 font-bold uppercase tracking-wide mb-1">Duration</p><p class="text-sm text-gray-800 font-bold">${formatDuration(data.duration)}</p></div>
        <div class="flex flex-col items-center text-center"><p class="text-[10px] text-gray-400 font-bold uppercase tracking-wide mb-1">Status</p><p class="text-sm text-emerald-600 font-bold uppercase tracking-wide">${data.call_status ? data.call_status.toLowerCase() : 'Answered'}</p></div>
      </div>
      ${data.notes ? `<div class="flex gap-3 mb-4 px-1"><div class="text-primary opacity-30 shrink-0"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H16.017C14.9124 8 14.017 7.10457 14.017 6V5C14.017 3.89543 14.9124 3 16.017 3H19.017C21.2261 3 23.017 4.79086 23.017 7V15C23.017 18.3137 20.3307 21 17.017 21H14.017ZM1.017 21L1.017 18C1.017 16.8954 1.91243 16 3.017 16H6.017C6.56928 16 7.017 15.5523 7.017 15V9C7.017 8.44772 6.56928 8 6.017 8H3.017C1.91243 8 1.017 7.10457 1.017 6V5C1.017 3.89543 1.91243 3 3.017 3H6.017C8.22614 3 10.017 4.79086 10.017 7V15C10.017 18.3137 7.33072 21 4.017 21H1.017Z"/></svg></div><p class="text-sm text-gray-700 font-medium leading-relaxed italic line-clamp-3">${data.notes}</p></div>` : ''}
      <div class="h-px bg-gray-50 mb-4"></div>
      <div class="flex items-center justify-between mb-3 px-1">
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-green-50 text-emerald-600 border border-emerald-100 font-bold text-xs shadow-sm"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.382-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg> ${outcomeText}</div>
        <div class="flex items-center gap-1.5 text-gray-400"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg><span class="text-xs font-bold text-gray-500 uppercase tracking-tight">${data.telecaller_name}</span></div>
      </div>
      <div class="audio-container w-full pt-1"><div class="h-10 w-full bg-gray-50 rounded-xl flex items-center justify-center border border-dashed border-gray-200"><span class="text-xs text-gray-400 font-medium italic">Recording pending sync</span></div></div>`;
    todayHeader.after(card);
    updatePagination();
  });
  socket.on('recording_ready', (data) => {
    [document.getElementById(`log-${data.log_id}`), document.getElementById(`card-log-${data.log_id}`)].forEach(item => {
       if (item) {
         const container = item.querySelector('.audio-container');
         if (container) {
           container.innerHTML = `<audio controls src="${data.recording_url}" class="h-9 w-full outline-none bg-gray-50 rounded-lg"></audio>`;
         }
       }
    });
  });
</script>

<style>
@keyframes fadeInUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
.animate-fade-in-up { animation: fadeInUp 0.4s ease-out forwards; }
.hidden-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
.hidden-scrollbar::-webkit-scrollbar-thumb { background-color: #CBD5E1; border-radius: 20px; }
.date-header { top: 0; z-index: 10; }
</style>

<%- include('partials/footer') %>
