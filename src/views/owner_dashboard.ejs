<%- include('partials/header') %>

<div class="animate-fade-in-up">
    <!-- Header Section -->
    <div class="mb-2 flex md:flex-row flex-col justify-between md:items-center px-2 sm:px-0">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 border-b-4 border-primary inline-block pb-1">Owner Dashboard</h2>
        <p class="text-sm font-medium text-gray-500 mt-2">Welcome back, <%= user.name %></p>
      </div>

      <!-- Telecaller Filter (Premium Custom Dropdown) -->
      <div x-show="activeTab === 'performance'" 
           x-data="{ open: false }"
           @click.away="open = false"
           class="mt-4 md:mt-0 md:mr-8 relative z-20">
        
        <button @click="open = !open" 
                class="flex items-center space-x-4 bg-white/90 backdrop-blur-md px-6 py-2.5 rounded-2xl shadow-lg shadow-gray-200/40 border border-gray-100 hover:border-primary/20 transition-all duration-300">
          <span class="text-sm font-black text-gray-900" x-text="document.querySelector('[data-agent-id=\'' + selectedAgent + '\']')?.innerText || 'Select Telecaller'"></span>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-300" :class="open ? 'rotate-180' : ''" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </button>

        <!-- Dropdown Menu -->
        <div x-show="open" 
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 scale-95 translate-y-2"
             x-transition:enter-end="opacity-100 scale-100 translate-y-0"
             x-transition:leave="transition ease-in duration-100"
             class="absolute right-0 mt-3 w-56 bg-white/95 backdrop-blur-xl rounded-3xl shadow-2xl border border-gray-100 py-3 overflow-y-auto max-h-72 hidden-scrollbar z-50">
          


          <% if (locals.telecallerPerformance) { telecallerPerformance.forEach(function(perf) { %>
            <button @click="selectedAgent = '<%= perf.id %>'; open = false" 
                    data-agent-id="<%= perf.id %>"
                    class="w-full px-6 py-2.5 text-left hover:bg-gray-50 flex items-center justify-between transition-colors">
              <div class="flex items-center space-x-3">
                <div class="w-1.5 h-1.5 rounded-full" :class="selectedAgent === '<%= perf.id %>' ? 'bg-primary' : 'bg-transparent'"></div>
                <span class="text-sm font-bold" :class="selectedAgent === '<%= perf.id %>' ? 'text-primary' : 'text-gray-700'"><%= perf.name %></span>
              </div>
              <div data-presence-id="<%= perf.id %>" class="w-2 h-2 rounded-full <%= (perf.last_seen && (new Date() - new Date(perf.last_seen) < 60000)) ? 'bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.5)]' : 'bg-gray-200' %>"></div>
            </button>
          <% }); } %>
        </div>
      </div>
    </div>
  <div class="px-0 pt-0 pb-4 sm:px-0">
    <!-- Actions Section -->
    <div x-show="activeTab === 'upload'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 transform translate-y-4" x-transition:enter-end="opacity-100 transform translate-y-0" class="space-y-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Stat Card -->
        <div class="bg-white shadow rounded-2xl border border-gray-100 flex items-center p-6 h-full">
          <div class="p-3 rounded-xl bg-blue-50 text-blue-500 mr-4">
            <svg class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500 truncate">Total Leads</p>
            <p class="mt-1 text-4xl font-semibold text-gray-900"><%= stats.total %></p>
          </div>
        </div>

        <!-- Upload Card -->
        <div class="bg-white shadow rounded-2xl border border-gray-100 p-6 md:col-span-1 lg:col-span-2 h-full">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg leading-6 font-bold text-gray-900">Upload New Leads (CSV/Excel)</h3>
          <a href="/sample_leads.csv" download class="text-sm font-medium text-blue-600 hover:text-blue-500 flex items-center transition-colors">
            <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Download Sample
          </a>
        </div>
        <form action="/owner/upload-leads" method="POST" enctype="multipart/form-data" class="flex items-center space-x-4">
          <div class="flex-1">
            <input type="file" name="leads_file" accept=".csv, .xlsx, .xls" required class="block w-full text-sm text-gray-500
              file:mr-4 file:py-2 file:px-4
              file:rounded-full file:border-0
              file:text-sm file:font-semibold
              file:bg-container file:text-primary
              hover:file:bg-red-100"
            />
          </div>
          <button type="submit" class="btn-primary flex items-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
            </svg>
            Upload
          </button>
        </form>
        </div>
      </div>

      <!-- Upload Feedback Banners -->
      <% if (locals.uploadMsg) { %>
        <div class="flex items-center gap-3 px-5 py-4 bg-green-50 border border-green-200 rounded-2xl text-green-700 text-sm font-semibold shadow-sm">
          <svg class="w-5 h-5 shrink-0 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          <%= uploadMsg %>
        </div>
      <% } %>
      <% if (locals.errorMsg) { %>
        <div class="flex items-center gap-3 px-5 py-4 bg-red-50 border border-red-200 rounded-2xl text-red-700 text-sm font-semibold shadow-sm">
          <svg class="w-5 h-5 shrink-0 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
          <%= errorMsg %>
        </div>
      <% } %>

      <!-- Leads Table -->
      <div class="bg-white shadow rounded-2xl overflow-hidden border border-gray-100">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50/50 flex justify-between items-center">
            <h3 class="text-lg leading-6 font-bold text-gray-900">Your Leads</h3>
          </div>
          
          <div class="overflow-x-auto relative hidden-scrollbar border-t border-gray-100 hidden md:block">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm border-b border-gray-200">
                <tr>
                  <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Name</th>
                  <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Mobile</th>
                  <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Assigned To</th>
                  <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Added On</th>
                </tr>
              </thead>
              <tbody id="leads-table-body" class="bg-white divide-y divide-gray-200">
                <% if (locals.leads && leads.length > 0) { %>
                  <% leads.forEach(function(lead) { %>
                    <tr class="lead-row hover:bg-gray-50 transition-colors cursor-pointer" 
                        data-lead="<%= JSON.stringify(lead) %>"
                        @click="openLeadDetails($el.dataset.lead)">
                      <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900"><%= lead.name %></td>
                      <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500 font-medium"><%= lead.phone %></td>
                      <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-700">
                        <% if (lead.telecaller) { %>
                          <span class="inline-flex items-center gap-1.5 font-medium"><span class="w-1.5 h-1.5 rounded-full bg-blue-400 shrink-0"></span><%= lead.telecaller.device_alias || lead.telecaller.name %></span>
                        <% } else { %>
                          <span class="text-gray-400 italic text-[10px]">Unassigned</span>
                        <% } %>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-500 font-medium"><%= new Date(lead.created_at).toLocaleDateString('en-IN') %></td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Mobile Card View (Leads) -->
          <div id="leads-cards-container" class="md:hidden divide-y divide-gray-100">
             <% if (locals.leads && leads.length > 0) { %>
               <% leads.forEach(function(lead) { %>
                  <div class="lead-card p-5 hover:bg-gray-50 transition-colors cursor-pointer" 
                       data-lead="<%= JSON.stringify(lead) %>"
                       @click="openLeadDetails($el.dataset.lead)">
                    <div class="flex justify-between items-start">
                      <div>
                        <h4 class="text-base font-bold text-gray-900"><%= lead.name %></h4>
                        <p class="text-sm text-gray-500 font-medium mt-1"><%= lead.phone %></p>
                      </div>
                      <% if (lead.telecaller) { %>
                        <span class="text-[10px] bg-blue-50 text-blue-600 px-2.5 py-1 rounded-full font-bold uppercase tracking-wider"><%= lead.telecaller.device_alias || lead.telecaller.name %></span>
                      <% } %>
                    </div>
                  </div>
               <% }); %>
             <% } %>
          </div>
          
          <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
             <div class="flex flex-col sm:flex-row gap-4 items-center justify-between">
                <div class="text-xs text-gray-500 font-medium" id="leads-pagination-info">
                  Showing <span id="leads-start-range">0</span> to <span id="leads-end-range">0</span> of <span id="leads-total-count">0</span> leads
                </div>
                <div class="hidden md:flex items-center gap-2">
                  <button id="leads-prev-page" class="p-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 hover:text-primary disabled:opacity-30 transition-all"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg></button>
                  <div id="leads-page-numbers" class="flex items-center gap-1"></div>
                  <button id="leads-next-page" class="p-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 hover:text-primary disabled:opacity-30 transition-all"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></button>
                </div>
                <button id="leads-load-more" class="md:hidden w-full py-3 rounded-2xl border-2 border-gray-100 bg-white text-xs font-bold text-gray-600 shadow-sm transition-all">Load More Leads</button>
             </div>
          </div>
      </div>

      <!-- Assign Unassigned Leads Panel -->
      <div class="bg-white shadow rounded-2xl border border-gray-100 p-6">
        <div class="flex flex-col sm:flex-row sm:items-end gap-4">
          <div class="flex-1">
            <h3 class="text-base font-bold text-gray-900 mb-1">Assign Unassigned Leads</h3>
            <p class="text-xs text-gray-400 mb-4">Select a telecaller below to assign all currently <span class="font-semibold text-amber-600">unassigned</span> leads to them.</p>
            <form action="/owner/assign-leads" method="POST" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <div class="flex-1">
                <label class="block text-xs font-semibold text-gray-500 mb-1">Select Telecaller <span class="text-red-500">*</span></label>
                <select name="telecaller_id" required
                  class="w-full block rounded-xl border border-gray-200 bg-gray-50 text-sm text-gray-700 py-2.5 px-3 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all">
                  <option value="">— Select a Telecaller —</option>
                  <% if (locals.telecallers && telecallers.length > 0) { %>
                    <% telecallers.forEach(function(tc) { %>
                      <option value="<%= tc.id %>"><%= tc.name %></option>
                    <% }); %>
                  <% } else { %>
                    <option disabled>No telecallers assigned to you yet</option>
                  <% } %>
                </select>
              </div>
              <button type="submit" class="btn-primary flex items-center justify-center shrink-0 mt-5">
                <svg class="w-4 h-4 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Assign All Unassigned
              </button>
            </form>
          </div>
        </div>

        <!-- Assign feedback messages -->
        <% if (locals.assignMsg) { %>
          <p class="mt-4 text-sm text-green-600 font-bold flex items-center">
            <svg class="w-4 h-4 mr-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <%= assignMsg %>
          </p>
        <% } %>
        <% if (locals.assignError) { %>
          <p class="mt-4 text-sm text-red-600 font-bold flex items-center">
            <svg class="w-5 h-5 mr-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            <%= assignError %>
          </p>
        <% } %>
      </div>
    </div>

    <!-- Detailed View Feed -->
    <div x-show="activeTab === 'activity'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 transform translate-y-4" x-transition:enter-end="opacity-100 transform translate-y-0" class="md:bg-white md:shadow md:rounded-2xl overflow-hidden md:border md:border-gray-100">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50/50 flex flex-col md:flex-row justify-between items-center gap-4">
        <h3 class="text-lg leading-6 font-bold text-gray-900">Detailed View</h3>
        
        <!-- Date Filter & Export -->
        <div class="flex flex-wrap items-center gap-3 bg-white p-2 rounded-2xl shadow-sm border border-gray-100">
          <div class="flex items-center gap-2 px-3 py-1.5 bg-gray-50 rounded-xl">
            <span class="text-[10px] font-black text-gray-400 uppercase tracking-wider">From</span>
            <input type="date" x-model="exportStart" class="bg-transparent border-none text-xs font-bold text-gray-700 focus:ring-0 p-0">
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 bg-gray-50 rounded-xl">
            <span class="text-[10px] font-black text-gray-400 uppercase tracking-wider">To</span>
            <input type="date" x-model="exportEnd" class="bg-transparent border-none text-xs font-bold text-gray-700 focus:ring-0 p-0">
          </div>
          <a :href="`/owner/export-calls?start=${exportStart}&end=${exportEnd}`" 
             class="flex items-center gap-2 bg-primary text-white px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-red-600 transition-all shadow-lg shadow-red-200 hover:-translate-y-0.5 active:translate-y-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Export Excel
          </a>
        </div>
      </div>

       <div class="overflow-x-auto relative hidden-scrollbar border-t border-gray-100 hidden md:block">
           <table class="min-w-full divide-y divide-gray-200">
             <!-- ... table header ... -->
             <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm border-b border-gray-200">
               <tr>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Customer Name</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Mobile</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Timestamp</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Duration</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Status</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Outcome</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Remarks</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Telecaller</th>
                 <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Recording</th>
               </tr>
             </thead>
             <tbody id="live-calls" class="bg-white divide-y divide-gray-200">
               <% if (locals.callLogs && callLogs.length > 0) { %>
                 <% callLogs.forEach(function(log) { %>
                   <tr id="log-<%= log.id %>" class="log-row hover:bg-gray-50 transition-colors animate-fade-in-up cursor-pointer" data-lead="<%= JSON.stringify(log.lead) %>" @click="openLeadDetails($el.dataset.lead, '<%= log.outcome || log.call_status %>')">
                     <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900"><%= log.lead.name %></td>
                     <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500 font-medium"><%= log.lead.phone %></td>
                     <td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-500 font-medium"><%= new Date(log.created_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', hour12: true }) %></td>
                     <td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-700 font-bold"><%= Math.floor(log.duration_seconds / 60).toString().padStart(2, '0') %>:<%= (log.duration_seconds % 60).toString().padStart(2, '0') %></td>
                     <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900 capitalize"><%= log.call_status ? log.call_status.toLowerCase() : '' %></td>
                     <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900 capitalize"><%= (log.outcome && log.outcome !== 'PENDING' ? log.outcome : '—').toLowerCase().replace(/_/g, ' ') %></td>
                     <td class="px-6 py-4"><div class="text-[11px] text-gray-600 italic max-w-xs truncate" title="<%= log.notes %>"><%= log.notes || '—' %></div></td>
                     <td class="px-6 py-4 whitespace-nowrap text-xs font-medium text-gray-700"><%= log.telecaller.device_alias || log.telecaller.name %></td>
                     <td class="px-6 py-4 whitespace-nowrap"><div class="audio-container"><% if (log.recording_url) { %><audio controls src="<%= log.recording_url %>" class="h-6 w-32 outline-none"></audio><% } %></div></td>
                   </tr>
                 <% }); %>
               <% } %>
             </tbody>
           </table>
       </div>

       <!-- Mobile Card View (Premium - Optimized Space) -->
       <div id="activity-cards-container" class="md:hidden pb-12">
          <% if (locals.callLogs && callLogs.length > 0) { 
               let lastDate = "";
               callLogs.forEach(function(log) { 
                 const logDate = new Date(log.created_at).toLocaleDateString('en-IN', { day:'2-digit', month:'long', year:'numeric' });
                 if (logDate !== lastDate) { lastDate = logDate; %>
              <div class="date-header px-4 py-3 bg-white/95 backdrop-blur-md text-[10px] font-bold text-gray-400 sticky top-0 z-10 border-b border-gray-100 uppercase tracking-[0.2em] mb-6 mt-10 first:mt-0"><%= logDate %></div>
          <% } %>
              <div id="card-log-<%= log.id %>" 
                   class="activity-card bg-white p-5 mb-8 shadow-[0_15px_50px_rgba(0,0,0,0.15)] border border-gray-100 rounded-2xl mx-3 animate-fade-in-up cursor-pointer"
                   data-lead="<%= JSON.stringify(log.lead) %>"
                   @click="openLeadDetails($el.dataset.lead, '<%= log.outcome || log.call_status %>')">
                <!-- Header: Info (No redundant badge) -->
                <div class="mb-3">
                  <h4 class="text-lg font-bold text-gray-900 leading-tight tracking-tight"><%= log.lead.name %></h4>
                  <p class="text-sm text-gray-500 font-bold mt-0.5 tracking-tight"><%= log.lead.phone %></p>
                </div>

                <!-- Stats Row (Compact) -->
                <div class="grid grid-cols-3 gap-0.5 py-3 border-y border-gray-100 mb-3">
                  <div class="flex flex-col items-center text-center">
                    <p class="text-[10px] text-gray-400 font-bold uppercase tracking-wide mb-1">Time</p>
                    <p class="text-sm text-gray-800 font-bold"><%= new Date(log.created_at).toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit', hour12: true }) %></p>
                  </div>
                  <div class="flex flex-col items-center text-center border-x border-gray-100 px-1">
                    <p class="text-[10px] text-gray-400 font-bold uppercase tracking-wide mb-1">Duration</p>
                    <p class="text-sm text-gray-800 font-bold"><%= Math.floor(log.duration_seconds / 60).toString().padStart(2, '0') %>:<%= (log.duration_seconds % 60).toString().padStart(2, '0') %></p>
                  </div>
                  <div class="flex flex-col items-center text-center">
                    <p class="text-[10px] text-gray-400 font-bold uppercase tracking-wide mb-1">Status</p>
                    <% 
                      const statusColors = {
                        'PENDING': 'text-amber-500',
                        'INTERESTED': 'text-emerald-500',
                        'ORDERED': 'text-emerald-600',
                        'BOOKED': 'text-emerald-700',
                        'BANK_PTP': 'text-emerald-600',
                        'FPTP': 'text-emerald-600',
                        'PTP': 'text-emerald-600',
                        'REJECTED': 'text-red-500',
                        'CANCELLED': 'text-red-600',
                        'CALL_DISCONNECT': 'text-red-500',
                        'OUT_OF_SERVICE': 'text-red-600',
                        'SWITCH_OFF': 'text-red-600',
                        'INCOMING_NOT_AVAIABLE': 'text-red-600',
                        'RTP': 'text-red-700',
                        'MISSED': 'text-gray-400',
                        'BUSY': 'text-gray-500',
                        'NOT_REACHABLE': 'text-gray-400',
                        'RNR': 'text-gray-400',
                        'CB_REQUEST': 'text-blue-500',
                        'LEFT_MSG': 'text-blue-400',
                        'REMIND_LATER': 'text-indigo-500',
                        'PARTIAL_PAID': 'text-purple-500',
                        'ALREADY_PAID': 'text-purple-600',
                        'DEATH': 'text-black',
                        'LOST': 'text-gray-600'
                      };
                      const statusClass = statusColors[log.outcome] || statusColors[log.call_status] || 'text-emerald-600';
                    %>
                    <p class="text-sm font-bold uppercase tracking-wide <%= statusClass %>"><%= (log.outcome || log.call_status || 'Answered').toLowerCase().replace(/_/g, ' ') %></p>
                  </div>
                </div>

                <!-- Remarks Section (Reduced Height) -->
                <% if (log.notes) { %>
                  <div class="flex gap-3 mb-4 px-1">
                    <div class="text-primary opacity-30 shrink-0">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H16.017C14.9124 8 14.017 7.10457 14.017 6V5C14.017 3.89543 14.9124 3 16.017 3H19.017C21.2261 3 23.017 4.79086 23.017 7V15C23.017 18.3137 20.3307 21 17.017 21H14.017ZM1.017 21L1.017 18C1.017 16.8954 1.91243 16 3.017 16H6.017C6.56928 16 7.017 15.5523 7.017 15V9C7.017 8.44772 6.56928 8 6.017 8H3.017C1.91243 8 1.017 7.10457 1.017 6V5C1.017 3.89543 1.91243 3 3.017 3H6.017C8.22614 3 10.017 4.79086 10.017 7V15C10.017 18.3137 7.33072 21 4.017 21H1.017Z"/></svg>
                    </div>
                    <p class="text-sm text-gray-700 font-medium leading-relaxed italic line-clamp-3"><%= log.notes %></p>
                  </div>
                <% } %>

                <div class="h-px bg-gray-50 mb-4"></div>

                <!-- Footer Row (Compact) -->
                <div class="flex items-center justify-between mb-3 px-1">
                  <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-bold text-xs shadow-sm 
                    <% 
                      const bgColors = {
                        'PENDING': 'bg-amber-50 text-amber-600 border-amber-100',
                        'INTERESTED': 'bg-green-50 text-emerald-600 border-emerald-100',
                        'ORDERED': 'bg-green-50 text-emerald-600 border-emerald-100',
                        'BOOKED': 'bg-green-50 text-emerald-600 border-emerald-100',
                        'BANK_PTP': 'bg-green-50 text-emerald-600 border-emerald-100',
                        'FPTP': 'bg-green-50 text-emerald-600 border-emerald-100',
                        'PTP': 'bg-green-50 text-emerald-600 border-emerald-100',
                        'REJECTED': 'bg-red-50 text-red-600 border-red-100',
                        'CANCELLED': 'bg-red-50 text-red-600 border-red-100',
                        'CALL_DISCONNECT': 'bg-red-50 text-red-600 border-red-100',
                        'OUT_OF_SERVICE': 'bg-red-50 text-red-600 border-red-100',
                        'SWITCH_OFF': 'bg-red-50 text-red-600 border-red-100',
                        'INCOMING_NOT_AVAIABLE': 'bg-red-50 text-red-600 border-red-100',
                        'RTP': 'bg-red-50 text-red-600 border-red-100',
                        'MISSED': 'bg-gray-50 text-gray-500 border-gray-100',
                        'BUSY': 'bg-gray-50 text-gray-500 border-gray-100',
                        'NOT_REACHABLE': 'bg-gray-50 text-gray-500 border-gray-100',
                        'RNR': 'bg-gray-50 text-gray-500 border-gray-100',
                        'CB_REQUEST': 'bg-blue-50 text-blue-600 border-blue-100',
                        'LEFT_MSG': 'bg-blue-50 text-blue-600 border-blue-100',
                        'REMIND_LATER': 'bg-indigo-50 text-indigo-600 border-indigo-100',
                        'PARTIAL_PAID': 'bg-purple-50 text-purple-600 border-purple-100',
                        'ALREADY_PAID': 'bg-purple-50 text-purple-600 border-purple-100',
                        'DEATH': 'bg-gray-900 text-white border-gray-800',
                        'LOST': 'bg-gray-100 text-gray-600 border-gray-200'
                      };
                      const bgClass = bgColors[log.outcome] || bgColors[log.call_status] || 'bg-green-50 text-emerald-600 border-emerald-100';
                    %>
                    <%= bgClass %>">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.382-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
                    <%= (log.outcome && log.outcome !== 'PENDING' ? log.outcome : log.call_status || 'Interested').toLowerCase().replace(/_/g, ' ') %>
                  </div>
                  <div class="flex items-center gap-1.5 text-gray-400">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    <span class="text-xs font-bold text-gray-500 uppercase tracking-tight"><%= log.telecaller.device_alias || log.telecaller.name %></span>
                  </div>
                </div>

                <!-- Audio Player row (Explicit Visibility) -->
                <div class="audio-container w-full pt-1">
                   <% if (log.recording_url) { %>
                     <audio controls src="<%= log.recording_url %>" class="h-10 w-full outline-none bg-gray-50 rounded-xl"></audio>
                   <% } else { %>
                     <div class="h-10 w-full bg-gray-50 rounded-xl flex items-center justify-center border border-dashed border-gray-200">
                        <span class="text-xs text-gray-400 font-medium italic">Recording pending sync</span>
                     </div>
                   <% } %>
                </div>
             </div>

          <% }); } %>
       </div>
       
       <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
          <div class="flex flex-col sm:flex-row gap-4 items-center justify-between">
             <div class="text-xs text-gray-500 font-medium" id="pagination-info">Showing <span id="start-range">0</span> to <span id="end-range">0</span> of <span id="total-count">0</span> logs</div>
             <div class="hidden md:flex items-center gap-2">
               <button id="prev-page" class="p-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 hover:text-primary transition-all"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg></button>
               <div id="page-numbers" class="flex items-center gap-1"></div>
               <button id="next-page" class="p-1.5 rounded-lg border border-gray-200 bg-white text-gray-400 hover:text-primary transition-all"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></button>
             </div>
             <div class="md:hidden w-full"><button id="activity-load-more" class="w-full py-3 rounded-2xl border-2 border-gray-100 bg-white text-xs font-bold text-gray-500 hover:border-primary hover:text-primary shadow-sm">Load More Activity</button></div>
          </div>
       </div>
    </div>

    <!-- Campaigns Section -->
    <div x-show="activeTab === 'campaigns'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 transform translate-y-4" x-transition:enter-end="opacity-100 transform translate-y-0" class="md:bg-white md:shadow md:rounded-2xl overflow-hidden md:border md:border-gray-100">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50/50 flex flex-col md:flex-row justify-between items-center gap-4">
        <h3 class="text-lg leading-6 font-bold text-gray-900">Campaign Management</h3>
      </div>

      <div class="overflow-x-auto relative hidden-scrollbar border-t border-gray-100 hidden md:block">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm border-b border-gray-200">
            <tr>
              <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Campaign / File Name</th>
              <th class="px-6 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-wider">Telecaller</th>
              <th class="px-6 py-3 text-center text-[10px] font-bold text-gray-500 uppercase tracking-wider">Total</th>
              <th class="px-6 py-3 text-center text-[10px] font-bold text-green-600 uppercase tracking-wider">Processed</th>
              <th class="px-6 py-3 text-center text-[10px] font-bold text-primary uppercase tracking-wider">Pending</th>
              <th class="px-6 py-3 text-right text-[10px] font-bold text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody id="campaigns-table-body" class="bg-white divide-y divide-gray-100">
            <% if (locals.campaigns && campaigns.length > 0) { %>
              <% campaigns.forEach(function(camp) { %>
                <tr class="campaign-row hover:bg-gray-50 transition-colors animate-fade-in-up">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                      <div class="w-10 h-10 rounded-xl bg-container flex items-center justify-center text-primary mr-4">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                      </div>
                      <div>
                        <p class="text-sm font-bold text-gray-900 capitalize text-wrap max-w-[200px] truncate" title="<%= camp.name %>"><%= camp.name %></p>
                        <p class="text-[10px] text-gray-400 font-medium">Batch Upload</p>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-xs font-bold text-gray-700 max-w-[150px] truncate" title="<%= camp.telecallerNames %>">
                      <%= camp.telecallerNames %>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-gray-100 text-gray-700 text-xs font-bold"><%= camp.total %></span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-green-50 text-green-700 text-xs font-bold"><%= camp.processed %></span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-red-50 text-primary text-xs font-bold"><%= camp.pending %></span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right">
                    <button 
                      @click="campaignToDelete = '<%= camp.name %>'; pendingLeadsToDelete = <%= camp.pending %>; deleteModalOpen = true"
                      class="p-2.5 rounded-xl bg-red-50 text-primary hover:bg-primary hover:text-white transition-all duration-300 shadow-sm disabled:opacity-30 disabled:cursor-not-allowed"
                      :disabled="<%= camp.pending === 0 %>"
                    >
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="px-6 py-12 text-center text-gray-400 italic font-medium">No active campaigns found</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Campaign Pagination Footer -->
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
        <div class="flex flex-col sm:flex-row gap-4 items-center justify-between">
          <div class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">
            Showing <span id="campaigns-start-range" class="text-gray-900">0</span> to <span id="campaigns-end-range" class="text-gray-900">0</span> of <span id="campaigns-total-count" class="text-gray-900">0</span> campaigns
          </div>
          
          <!-- Desktop Pagination -->
          <div class="hidden md:flex items-center gap-2">
            <button id="campaigns-prev-page" class="p-2 rounded-lg bg-white border border-gray-200 text-gray-500 hover:bg-gray-50 disabled:opacity-30 disabled:cursor-not-allowed transition-all">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <div id="campaigns-page-numbers" class="flex items-center gap-1">
              <!-- Page numbers injected here -->
            </div>
            <button id="campaigns-next-page" class="p-2 rounded-lg bg-white border border-gray-200 text-gray-500 hover:bg-gray-50 disabled:opacity-30 disabled:cursor-not-allowed transition-all">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
            </button>
          </div>

          <!-- Mobile Load More -->
          <div class="md:hidden w-full">
            <button id="campaigns-load-more" class="w-full py-3 rounded-xl bg-white border border-gray-200 text-xs font-bold text-gray-600 hover:bg-gray-50 transition-all">
              Load More Campaigns
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Card View (Campaigns) -->
      <div id="campaigns-cards-container" class="md:hidden divide-y divide-gray-100">
         <% if (locals.campaigns && campaigns.length > 0) { %>
           <% campaigns.forEach(function(camp) { %>
              <div class="campaign-card p-5 hover:bg-gray-50 transition-colors">
                <div class="flex justify-between items-start mb-4">
                  <div class="flex items-center">
                    <div class="w-10 h-10 rounded-xl bg-container flex items-center justify-center text-primary mr-3">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                    </div>
                    <div>
                      <h4 class="text-base font-bold text-gray-900 capitalize"><%= camp.name %></h4>
                      <p class="text-[10px] text-gray-400 font-bold uppercase tracking-wider"><%= camp.telecallerNames %></p>
                    </div>
                  </div>
                  <button 
                    @click="campaignToDelete = '<%= camp.name %>'; pendingLeadsToDelete = <%= camp.pending %>; deleteModalOpen = true"
                    class="p-2 rounded-lg bg-red-50 text-primary hover:bg-primary hover:text-white transition-all shadow-sm disabled:opacity-30"
                    :disabled="<%= camp.pending === 0 %>"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                  </button>
                </div>
                <div class="grid grid-cols-3 gap-2">
                  <div class="bg-gray-50 rounded-xl p-3 text-center">
                    <p class="text-[10px] text-gray-400 font-bold uppercase mb-1">Total</p>
                    <p class="text-sm font-black text-gray-900"><%= camp.total %></p>
                  </div>
                  <div class="bg-green-50/50 rounded-xl p-3 text-center">
                    <p class="text-[10px] text-green-600 font-bold uppercase mb-1">Processed</p>
                    <p class="text-sm font-black text-green-700"><%= camp.processed %></p>
                  </div>
                  <div class="bg-red-50/50 rounded-xl p-3 text-center">
                    <p class="text-[10px] text-primary font-bold uppercase mb-1">Pending</p>
                    <p class="text-sm font-black text-primary"><%= camp.pending %></p>
                  </div>
                </div>
              </div>
           <% }); %>
         <% } %>
      </div>
    </div>

    <!-- Performance Tab -->
    <div x-show="activeTab === 'performance'" 
         x-init="if (selectedAgent === 'all' && <%= (locals.telecallerPerformance && telecallerPerformance.length > 0) ? 'true' : 'false' %>) { selectedAgent = '<%= (locals.telecallerPerformance && telecallerPerformance.length > 0) ? telecallerPerformance[0].id : "all" %>' }"
         x-transition:enter="transition ease-out duration-300" 
         x-transition:enter-start="opacity-0 transform translate-y-4" 
         x-transition:enter-end="opacity-100 transform translate-y-0" 
         class="space-y-12 pb-20">
      
      <% if (locals.telecallerPerformance && telecallerPerformance.length > 0) { %>
        <% telecallerPerformance.forEach(function(perf) { %>
          <div x-show="selectedAgent === '<%= perf.id %>'" 
               x-transition:enter="transition ease-out duration-500" 
               x-transition:enter-start="opacity-0 translate-y-8" 
               x-transition:enter-end="opacity-100 translate-y-0"
               class="space-y-8">
            <!-- Telecaller Header (Avatar Removed) -->
            <div class="px-2">
              <div class="flex items-baseline gap-3">
                <h3 class="text-3xl font-black text-gray-900 tracking-tight leading-none"><%= perf.name %></h3>
                <div data-presence-id="<%= perf.id %>" class="flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider transition-all duration-500 <%= (perf.last_seen && (new Date() - new Date(perf.last_seen) < 60000)) ? 'bg-green-50 text-green-600 border border-green-100' : 'bg-gray-50 text-gray-400 border border-gray-100' %>">
                   <div class="presence-dot w-1.5 h-1.5 rounded-full <%= (perf.last_seen && (new Date() - new Date(perf.last_seen) < 60000)) ? 'bg-green-500 animate-pulse' : 'bg-gray-300' %>"></div>
                   <span class="presence-text"><%= (perf.last_seen && (new Date() - new Date(perf.last_seen) < 60000)) ? 'Online' : 'Offline' %></span>
                </div>
              </div>
              <p class="text-[10px] font-bold text-gray-400 uppercase tracking-[0.3em] mt-3">Agent Efficiency Scorecard</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <!-- Today's Stats -->
              <div class="bg-white rounded-[2.5rem] shadow-xl shadow-gray-200/40 border border-gray-100 overflow-hidden p-8 group hover:shadow-2xl transition-all duration-500">
                <div class="flex items-center justify-between mb-8">
                  <h4 class="text-lg font-bold text-gray-900 flex items-center">
                    <span class="relative flex h-2.5 w-2.5 mr-2.5">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-primary"></span>
                    </span>
                    Today's Activity
                  </h4>
                </div>
                
                <div class="grid grid-cols-2 gap-4 mb-6">
                  <div class="bg-gray-50/50 rounded-2xl p-4 border border-transparent shadow-xl shadow-gray-200/60 transition-all">
                    <p class="text-3xl font-black text-gray-900 tracking-tight"><%= perf.daily.total %></p>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-1">Total Calls</p>
                  </div>
                  <div class="bg-emerald-50/30 rounded-2xl p-4 border border-transparent shadow-xl shadow-gray-200/60 transition-all">
                    <p class="text-3xl font-black text-emerald-600 tracking-tight"><%= perf.daily.answered %></p>
                    <p class="text-[10px] font-bold text-emerald-600/60 uppercase tracking-widest mt-1">Answered</p>
                  </div>
                  <div class="bg-orange-50/30 rounded-2xl p-4 border border-transparent shadow-xl shadow-gray-200/60 transition-all">
                    <p class="text-3xl font-black text-orange-600 tracking-tight"><%= perf.daily.missed %></p>
                    <p class="text-[10px] font-bold text-orange-600/60 uppercase tracking-widest mt-1">Missed</p>
                  </div>
                  <div class="bg-red-50/30 rounded-2xl p-4 border border-transparent shadow-xl shadow-gray-200/60 transition-all">
                    <p class="text-3xl font-black text-red-600 tracking-tight"><%= perf.daily.rejected %></p>
                    <p class="text-[10px] font-bold text-red-600/60 uppercase tracking-widest mt-1">Rejected</p>
                  </div>
                </div>

                <!-- Talk Time Card (Enhanced Shadow) -->
                <div class="bg-white rounded-3xl p-8 flex items-center justify-between shadow-xl shadow-gray-200/60 border border-gray-100">
                  <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-[0.3em] mb-1">Total Talk Time (Today)</p>
                    <p class="text-4xl font-black text-gray-900 tracking-tighter"><%= perf.daily.talkTimeFormatted %></p>
                  </div>
                </div>
              </div>

              <!-- Monthly Stats -->
              <div class="bg-white rounded-[2.5rem] shadow-xl shadow-gray-200/40 border border-gray-100 overflow-hidden p-8 group hover:shadow-2xl transition-all duration-500">
                <div class="flex items-center justify-between mb-8">
                  <h4 class="text-lg font-bold text-gray-900 flex items-center">
                    <div class="p-2 rounded-lg bg-primary/10 text-primary mr-2.5">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </div>
                    Monthly Performance
                  </h4>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-6">
                  <div class="bg-gray-50/50 rounded-2xl p-4 border border-transparent shadow-xl shadow-gray-200/60 transition-all">
                    <p class="text-3xl font-black text-gray-900 tracking-tight"><%= perf.monthly.total %></p>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-1">Total Calls</p>
                  </div>
                  <div class="bg-emerald-50/30 rounded-2xl p-4 border border-transparent shadow-xl shadow-gray-200/60 transition-all">
                    <p class="text-3xl font-black text-emerald-600 tracking-tight"><%= perf.monthly.answered %></p>
                    <p class="text-[10px] font-bold text-emerald-600/60 uppercase tracking-widest mt-1">Answered</p>
                  </div>
                  <div class="bg-orange-50/30 rounded-2xl p-4 border border-transparent shadow-xl shadow-gray-200/60 transition-all">
                    <p class="text-3xl font-black text-orange-600 tracking-tight"><%= perf.monthly.missed %></p>
                    <p class="text-[10px] font-bold text-orange-600/60 uppercase tracking-widest mt-1">Missed</p>
                  </div>
                  <div class="bg-red-50/30 rounded-2xl p-4 border border-transparent shadow-xl shadow-gray-200/60 transition-all">
                    <p class="text-3xl font-black text-red-600 tracking-tight"><%= perf.monthly.rejected %></p>
                    <p class="text-[10px] font-bold text-red-600/60 uppercase tracking-widest mt-1">Rejected</p>
                  </div>
                </div>

                <!-- Talk Time Card (Enhanced Shadow) -->
                <div class="bg-white rounded-3xl p-8 flex items-center justify-between shadow-xl shadow-gray-200/60 border border-gray-100">
                  <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-[0.3em] mb-1">Total Talk Time (Month)</p>
                    <p class="text-4xl font-black text-gray-900 tracking-tighter"><%= perf.monthly.talkTimeFormatted %></p>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="h-px bg-gray-100 w-full opacity-50"></div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="flex flex-col items-center justify-center py-40 bg-white rounded-[4rem] border-2 border-dashed border-gray-100 shadow-inner">
           <div class="w-32 h-32 bg-gray-50 rounded-full flex items-center justify-center text-gray-200 mb-8">
              <svg class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
           </div>
           <h4 class="text-2xl font-black text-gray-900 mb-3 tracking-tight">No Active Telecallers</h4>
           <p class="text-gray-400 font-medium max-w-sm text-center leading-relaxed">Assigned agents will appear here with their detailed performance metrics once they start making calls.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  let currentPage = 1;
  let leadsPage = 1;
  let campaignsPage = 1;
  const rowsPerPage = 5;
  const mobilePerPage = 5;
  let currentMobilePage = 1;
  let currentLeadsMobilePage = 1;
  let currentCampaignsMobilePage = 1;
  
  // Global function for Alpine to open lead details
  window.openLeadDetails = function(leadData, interactionStatus = null) {
    let lead = leadData;
    if (typeof leadData === 'string') {
      try {
        lead = JSON.parse(leadData);
      } catch (e) {
        console.error("Failed to parse lead data", e);
        return;
      }
    }
    
    // Alpine v3 way to access global state
    const bodyData = Alpine.$data(document.body);
    if (bodyData) {
      bodyData.selectedLead = lead;
      // If we have a specific call outcome, use it, otherwise use lead status
      bodyData.displayStatus = (interactionStatus || lead.status || 'PENDING').toUpperCase();
      bodyData.leadModalOpen = true;
    }
  };

  function formatDuration(totalSeconds) {
    const mins = Math.floor(totalSeconds / 60);
    const secs = totalSeconds % 60;
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  }

  function updatePagination() {
    const tbody = document.getElementById('live-calls');
    const mobileContainer = document.getElementById('activity-cards-container');
    if (!tbody || !mobileContainer) return;
    const rows = Array.from(tbody.querySelectorAll('tr:not(#empty-state)'));
    const totalCount = rows.length;
    const totalPages = Math.ceil(totalCount / rowsPerPage) || 1;
    if (currentPage > totalPages) currentPage = totalPages;
    const start = (currentPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;
    rows.forEach((row, index) => { row.style.display = (index >= start && index < end) ? '' : 'none'; });
    const cards = Array.from(mobileContainer.querySelectorAll('.activity-card'));
    const mobileEnd = currentMobilePage * mobilePerPage;
    cards.forEach((card, index) => { card.style.display = index < mobileEnd ? '' : 'none'; });
    const headers = Array.from(mobileContainer.querySelectorAll('.date-header'));
    headers.forEach(header => {
       let next = header.nextElementSibling;
       let hasVisible = false;
       while(next && next.classList.contains('activity-card')) {
          if(next.style.display !== 'none') { hasVisible = true; break; }
          next = next.nextElementSibling;
       }
       header.style.display = hasVisible ? '' : 'none';
    });
    const loadMoreBtn = document.getElementById('activity-load-more');
    if(loadMoreBtn) loadMoreBtn.style.display = mobileEnd >= cards.length ? 'none' : '';
    if (document.getElementById('start-range')) document.getElementById('start-range').innerText = totalCount === 0 ? 0 : start + 1;
    if (document.getElementById('end-range')) document.getElementById('end-range').innerText = Math.min(end, totalCount);
    if (document.getElementById('total-count')) document.getElementById('total-count').innerText = totalCount;
    if (document.getElementById('prev-page')) document.getElementById('prev-page').disabled = currentPage === 1;
    if (document.getElementById('next-page')) document.getElementById('next-page').disabled = currentPage === totalPages;
    const pageContainer = document.getElementById('page-numbers');
    if (pageContainer) {
        pageContainer.innerHTML = '';
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        for (let i = startPage; i <= endPage; i++) {
          const btn = document.createElement('button');
          btn.className = `w-8 h-8 rounded-lg text-xs font-bold ${i === currentPage ? 'bg-primary text-white' : 'bg-white text-gray-500 hover:bg-gray-100'}`;
          btn.innerText = i;
          btn.onclick = () => { currentPage = i; updatePagination(); };
          pageContainer.appendChild(btn);
        }
    }
  }

  function updateLeadsPagination() {
    const tbody = document.getElementById('leads-table-body');
    const mobileContainer = document.getElementById('leads-cards-container');
    if (!tbody || !mobileContainer) return;
    const rows = Array.from(tbody.querySelectorAll('.lead-row'));
    const totalCount = rows.length;
    const totalPages = Math.ceil(totalCount / rowsPerPage) || 1;
    const start = (leadsPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;
    rows.forEach((row, index) => { row.style.display = (index >= start && index < end) ? '' : 'none'; });
    const cards = Array.from(mobileContainer.querySelectorAll('.lead-card'));
    const mobileEnd = currentLeadsMobilePage * mobilePerPage;
    cards.forEach((card, index) => { card.style.display = index < mobileEnd ? '' : 'none'; });
    const loadMoreBtn = document.getElementById('leads-load-more');
    if(loadMoreBtn) loadMoreBtn.style.display = mobileEnd >= cards.length ? 'none' : '';
    if (document.getElementById('leads-start-range')) document.getElementById('leads-start-range').innerText = totalCount === 0 ? 0 : start + 1;
    if (document.getElementById('leads-end-range')) document.getElementById('leads-end-range').innerText = Math.min(end, totalCount);
    if (document.getElementById('leads-total-count')) document.getElementById('leads-total-count').innerText = totalCount;
    if (document.getElementById('leads-prev-page')) document.getElementById('leads-prev-page').disabled = leadsPage === 1;
    if (document.getElementById('leads-next-page')) document.getElementById('leads-next-page').disabled = leadsPage === totalPages;
    const pageContainer = document.getElementById('leads-page-numbers');
    if (pageContainer) {
        pageContainer.innerHTML = '';
        let startPage = Math.max(1, leadsPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        for (let i = startPage; i <= endPage; i++) {
          const btn = document.createElement('button');
          btn.className = `w-8 h-8 rounded-lg text-xs font-bold ${i === leadsPage ? 'bg-primary text-white' : 'bg-white text-gray-500 hover:bg-gray-100'}`;
          btn.innerText = i;
          btn.onclick = () => { leadsPage = i; updateLeadsPagination(); };
          pageContainer.appendChild(btn);
        }
    }
  }

  function updateCampaignsPagination() {
    const tbody = document.getElementById('campaigns-table-body');
    const mobileContainer = document.getElementById('campaigns-cards-container');
    if (!tbody || !mobileContainer) return;
    const rows = Array.from(tbody.querySelectorAll('.campaign-row'));
    const totalCount = rows.length;
    const totalPages = Math.ceil(totalCount / rowsPerPage) || 1;
    const start = (campaignsPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;
    rows.forEach((row, index) => { row.style.display = (index >= start && index < end) ? '' : 'none'; });
    const cards = Array.from(mobileContainer.querySelectorAll('.campaign-card'));
    const mobileEnd = currentCampaignsMobilePage * mobilePerPage;
    cards.forEach((card, index) => { card.style.display = index < mobileEnd ? '' : 'none'; });
    const loadMoreBtn = document.getElementById('campaigns-load-more');
    if(loadMoreBtn) loadMoreBtn.style.display = mobileEnd >= cards.length ? 'none' : '';
    if (document.getElementById('campaigns-start-range')) document.getElementById('campaigns-start-range').innerText = totalCount === 0 ? 0 : start + 1;
    if (document.getElementById('campaigns-end-range')) document.getElementById('campaigns-end-range').innerText = Math.min(end, totalCount);
    if (document.getElementById('campaigns-total-count')) document.getElementById('campaigns-total-count').innerText = totalCount;
    if (document.getElementById('campaigns-prev-page')) document.getElementById('campaigns-prev-page').disabled = campaignsPage === 1;
    if (document.getElementById('campaigns-next-page')) document.getElementById('campaigns-next-page').disabled = campaignsPage === totalPages;
    const pageContainer = document.getElementById('campaigns-page-numbers');
    if (pageContainer) {
        pageContainer.innerHTML = '';
        let startPage = Math.max(1, campaignsPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        for (let i = startPage; i <= endPage; i++) {
          const btn = document.createElement('button');
          btn.className = `w-8 h-8 rounded-lg text-xs font-bold ${i === campaignsPage ? 'bg-primary text-white' : 'bg-white text-gray-500 hover:bg-gray-100'}`;
          btn.innerText = i;
          btn.onclick = () => { campaignsPage = i; updateCampaignsPagination(); };
          pageContainer.appendChild(btn);
        }
    }
  }

  document.getElementById('prev-page').onclick = () => { if (currentPage > 1) { currentPage--; updatePagination(); } };
  document.getElementById('next-page').onclick = () => { currentPage++; updatePagination(); };
  document.getElementById('activity-load-more').onclick = () => { currentMobilePage++; updatePagination(); };
  document.getElementById('leads-prev-page').onclick = () => { if (leadsPage > 1) { leadsPage--; updateLeadsPagination(); } };
  document.getElementById('leads-next-page').onclick = () => { leadsPage++; updateLeadsPagination(); };
  document.getElementById('leads-load-more').onclick = () => { currentLeadsMobilePage++; updateLeadsPagination(); };
  
  if (document.getElementById('campaigns-prev-page')) document.getElementById('campaigns-prev-page').onclick = () => { if (campaignsPage > 1) { campaignsPage--; updateCampaignsPagination(); } };
  if (document.getElementById('campaigns-next-page')) document.getElementById('campaigns-next-page').onclick = () => { campaignsPage++; updateCampaignsPagination(); };
  if (document.getElementById('campaigns-load-more')) document.getElementById('campaigns-load-more').onclick = () => { currentCampaignsMobilePage++; updateCampaignsPagination(); };

  updatePagination();
  updateLeadsPagination();
  updateCampaignsPagination();

  socket.emit('join_dashboard', '<%= user.id %>');
  socket.on('new_call_log', (data) => {
    const list = document.getElementById('live-calls');
    const cardList = document.getElementById('activity-cards-container');
    const existingRow = document.getElementById(`log-${data.log_id}`);
    const existingCard = document.getElementById(`card-log-${data.log_id}`);
    const outcomeText = data.outcome && data.outcome !== 'PENDING' ? data.outcome.toLowerCase().replace(/_/g, ' ') : (data.call_status || 'Interested').toLowerCase().replace(/_/g, ' ');
    const statusKey = (data.outcome && data.outcome !== 'PENDING' ? data.outcome : (data.call_status || 'INTERESTED')).toUpperCase();

    const getBgClass = (status) => {
        const bgColors = {
          'PENDING': 'bg-amber-50 text-amber-600 border-amber-100',
          'INTERESTED': 'bg-green-50 text-emerald-600 border-emerald-100',
          'ORDERED': 'bg-green-50 text-emerald-600 border-emerald-100',
          'BOOKED': 'bg-green-50 text-emerald-600 border-emerald-100',
          'BANK_PTP': 'bg-green-50 text-emerald-600 border-emerald-100',
          'FPTP': 'bg-green-50 text-emerald-600 border-emerald-100',
          'PTP': 'bg-green-50 text-emerald-600 border-emerald-100',
          'REJECTED': 'bg-red-50 text-red-600 border-red-100',
          'CANCELLED': 'bg-red-50 text-red-600 border-red-100',
          'CALL_DISCONNECT': 'bg-red-50 text-red-600 border-red-100',
          'OUT_OF_SERVICE': 'bg-red-50 text-red-600 border-red-100',
          'SWITCH_OFF': 'bg-red-50 text-red-600 border-red-100',
          'INCOMING_NOT_AVAIABLE': 'bg-red-50 text-red-600 border-red-100',
          'RTP': 'bg-red-50 text-red-600 border-red-100',
          'MISSED': 'bg-gray-50 text-gray-500 border-gray-100',
          'BUSY': 'bg-gray-50 text-gray-500 border-gray-100',
          'NOT_REACHABLE': 'bg-gray-50 text-gray-500 border-gray-100',
          'RNR': 'bg-gray-50 text-gray-500 border-gray-100',
          'CB_REQUEST': 'bg-blue-50 text-blue-600 border-blue-100',
          'LEFT_MSG': 'bg-blue-50 text-blue-600 border-blue-100',
          'REMIND_LATER': 'bg-indigo-50 text-indigo-600 border-indigo-100',
          'PARTIAL_PAID': 'bg-purple-50 text-purple-600 border-purple-100',
          'ALREADY_PAID': 'bg-purple-50 text-purple-100 border-purple-100',
          'DEATH': 'bg-gray-900 text-white border-gray-800',
          'LOST': 'bg-gray-100 text-gray-600 border-gray-200'
        };
        return bgColors[status] || 'bg-green-50 text-emerald-600 border-emerald-100';
    };

    if (existingRow) {
      const cells = existingRow.querySelectorAll('td');
      if (cells[5]) cells[5].innerText = outcomeText;
      if (cells[6]) cells[6].innerText = data.notes || '—';
      if(existingCard) {
         const badge = existingCard.querySelector('.activity-card .inline-flex');
         const notesDiv = existingCard.querySelector('.activity-card p.italic');
         if(badge) { 
           badge.className = `inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-bold text-xs shadow-sm ${getBgClass(statusKey)}`;
           badge.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.382-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg> ${outcomeText}`;
         }
         if(notesDiv) notesDiv.innerText = data.notes;
      }
      return;
    }

    const tr = document.createElement('tr');
    tr.id = `log-${data.log_id}`;
    tr.className = "log-row hover:bg-gray-50 transition-colors animate-fade-in-up";
    const ts = new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', hour12: true });
    
    // Prepare lead data for clicking new rows
    const leadData = {
      name: data.lead_name,
      phone: data.lead_phone,
      status: 'PENDING', // Default for new incoming calls
      additional_data: data.additional_data || {}
    };
    const leadStr = JSON.stringify(leadData).replace(/"/g, '&quot;');

    tr.innerHTML = `<td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900">${data.lead_name}</td><td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500 font-medium">${data.lead_phone}</td><td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-500 font-medium">${ts}</td><td class="px-6 py-4 whitespace-nowrap text-[11px] text-gray-700 font-bold">${formatDuration(data.duration)}</td><td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900 capitalize">${data.call_status ? data.call_status.toLowerCase() : ''}</td><td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900 capitalize">${outcomeText}</td><td class="px-6 py-4 text-[11px] text-gray-600 italic max-w-xs truncate">${data.notes || '—'}</td><td class="px-6 py-4 whitespace-nowrap text-xs font-medium text-gray-700">${data.telecaller_name}</td><td class="px-6 py-4 whitespace-nowrap"><div class="audio-container"></div></td>`;
    
    // Add click handler to new row
    tr.setAttribute('onclick', `window.openLeadDetails(${leadStr}, '${data.outcome || data.call_status}')`);
    tr.style.cursor = 'pointer';

    list.prepend(tr);

    const today = new Date().toLocaleDateString('en-IN', { day:'2-digit', month:'long', year:'numeric' });
    let todayHeader = Array.from(cardList.querySelectorAll('.date-header')).find(h => h.innerText.trim() === today);
    if(!todayHeader) {
       todayHeader = document.createElement('div');
       todayHeader.className = "date-header px-4 py-3 bg-white/95 backdrop-blur-md text-[10px] font-bold text-gray-400 sticky top-0 z-10 border-b border-gray-100 uppercase tracking-[0.2em] mb-6 mt-10 first:mt-0";
       todayHeader.innerText = today;
       cardList.prepend(todayHeader);
    }

    const card = document.createElement('div');
    card.id = `card-log-${data.log_id}`;
    card.className = "activity-card bg-white p-5 mb-8 shadow-[0_15px_50px_rgba(0,0,0,0.15)] border border-gray-100 rounded-2xl mx-3 animate-fade-in-up cursor-pointer";
    card.setAttribute('onclick', `window.openLeadDetails(${leadStr}, '${data.outcome || data.call_status}')`);
    const timeStr = new Date().toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit', hour12: true });
    
    card.innerHTML = `
      <div class="mb-3">
        <h4 class="text-lg font-bold text-gray-900 leading-tight tracking-tight">${data.lead_name}</h4>
        <p class="text-sm text-gray-500 font-bold mt-0.5 tracking-tight">${data.lead_phone}</p>
      </div>
      <div class="grid grid-cols-3 gap-0.5 py-3 border-y border-gray-100 mb-3">
        <div class="flex flex-col items-center text-center"><p class="text-[10px] text-gray-400 font-bold uppercase tracking-wide mb-1">Time</p><p class="text-sm text-gray-800 font-bold">${timeStr}</p></div>
        <div class="flex flex-col items-center text-center border-x border-gray-100 px-1"><p class="text-[10px] text-gray-400 font-bold uppercase tracking-wide mb-1">Duration</p><p class="text-sm text-gray-800 font-bold">${formatDuration(data.duration)}</p></div>
        <div class="flex flex-col items-center text-center"><p class="text-[10px] text-gray-400 font-bold uppercase tracking-wide mb-1">Status</p><p class="text-sm text-emerald-600 font-bold uppercase tracking-wide">${data.call_status ? data.call_status.toLowerCase() : 'Answered'}</p></div>
      </div>
      ${data.notes ? `<div class="flex gap-3 mb-4 px-1"><div class="text-primary opacity-30 shrink-0"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H16.017C14.9124 8 14.017 7.10457 14.017 6V5C14.017 3.89543 14.9124 3 16.017 3H19.017C21.2261 3 23.017 4.79086 23.017 7V15C23.017 18.3137 20.3307 21 17.017 21H14.017ZM1.017 21L1.017 18C1.017 16.8954 1.91243 16 3.017 16H6.017C6.56928 16 7.017 15.5523 7.017 15V9C7.017 8.44772 6.56928 8 6.017 8H3.017C1.91243 8 1.017 7.10457 1.017 6V5C1.017 3.89543 1.91243 3 3.017 3H6.017C8.22614 3 10.017 4.79086 10.017 7V15C10.017 18.3137 7.33072 21 4.017 21H1.017Z"/></svg></div><p class="text-sm text-gray-700 font-medium leading-relaxed italic line-clamp-3">${data.notes}</p></div>` : ''}
      <div class="h-px bg-gray-50 mb-4"></div>
      <div class="flex items-center justify-between mb-3 px-1">
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg ${getBgClass(statusKey)} font-bold text-xs shadow-sm"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.382-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg> ${outcomeText}</div>
        <div class="flex items-center gap-1.5 text-gray-400"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg><span class="text-xs font-bold text-gray-500 uppercase tracking-tight">${data.telecaller_name}</span></div>
      </div>
      <div class="audio-container w-full pt-1"><div class="h-10 w-full bg-gray-50 rounded-xl flex items-center justify-center border border-dashed border-gray-200"><span class="text-xs text-gray-400 font-medium italic">Recording pending sync</span></div></div>`;
    todayHeader.after(card);
    updatePagination();
  });
  socket.on('recording_ready', (data) => {
    [document.getElementById(`log-${data.log_id}`), document.getElementById(`card-log-${data.log_id}`)].forEach(item => {
       if (item) {
         const container = item.querySelector('.audio-container');
         if (container) {
           container.innerHTML = `<audio controls src="${data.recording_url}" class="h-9 w-full outline-none bg-gray-50 rounded-lg"></audio>`;
         }
       }
    });
  });

  socket.on('presence_update', (data) => {
    const containers = document.querySelectorAll(`[data-presence-id="${data.telecallerId}"]`);
    containers.forEach(container => {
      const dot = container.querySelector('.presence-dot');
      const text = container.querySelector('.presence-text');
      
      if (data.isOnline) {
        // Update larger scorecard indicator
        if (container.classList.contains('px-2.5')) {
          container.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider transition-all duration-500 bg-green-50 text-green-600 border border-green-100';
          if (dot) dot.className = 'presence-dot w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse';
          if (text) text.innerText = 'Online';
        } 
        // Update smaller dropdown dot
        else if (container.classList.contains('w-2')) {
          container.className = 'w-2 h-2 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.5)]';
        }
      } else {
        // Update larger scorecard indicator
        if (container.classList.contains('px-2.5')) {
          container.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider transition-all duration-500 bg-gray-50 text-gray-400 border border-gray-100';
          if (dot) dot.className = 'presence-dot w-1.5 h-1.5 rounded-full bg-gray-300';
          if (text) text.innerText = 'Offline';
        }
        // Update smaller dropdown dot
        else if (container.classList.contains('w-2')) {
          container.className = 'w-2 h-2 rounded-full bg-gray-200';
        }
      }
    });
  });

  async function confirmDeleteCampaign() {
    const bodyData = Alpine.$data(document.body);
    const fileName = bodyData.campaignToDelete;
    const pendingCount = bodyData.pendingLeadsToDelete;
    
    if (!fileName) return;

    try {
      const response = await fetch('/owner/delete-campaign-leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fileName })
      });

      const result = await response.json();
      if (result.success) {
        bodyData.deleteModalOpen = false;
        window.location.reload();
      } else {
        alert('Error: ' + (result.error || 'Failed to delete leads'));
      }
    } catch (err) {
      console.error(err);
      alert('Network error. Please try again.');
    }
  }
</script>

<!-- Campaign Delete Confirmation Modal -->
<div x-show="deleteModalOpen" 
     x-cloak
     class="fixed inset-0 z-[60] flex items-center justify-center p-4 bg-gray-900/60 backdrop-blur-md"
     x-transition:enter="transition ease-out duration-300"
     x-transition:enter-start="opacity-0"
     x-transition:enter-end="opacity-100">
    
    <div @click.away="deleteModalOpen = false" 
         class="bg-white rounded-[2rem] shadow-2xl w-full max-w-md overflow-hidden transform transition-all border border-gray-100"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 scale-95 translate-y-4"
         x-transition:enter-end="opacity-100 scale-100 translate-y-0">
        
        <div class="p-8 text-center">
            <div class="w-20 h-20 bg-red-50 rounded-3xl flex items-center justify-center text-red-500 mx-auto mb-6">
                <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
            </div>
            
            <h3 class="text-2xl font-black text-gray-900 mb-3 tracking-tight">Confirm Deletion</h3>
            <p class="text-sm text-gray-500 font-medium leading-relaxed px-4">
                Are you sure you want to delete all <span class="text-red-600 font-bold" x-text="pendingLeadsToDelete"></span> pending leads from campaign <span class="text-gray-900 font-bold" x-text="'&quot;' + campaignToDelete + '&quot;'"></span>?
