<%- include('partials/header') %>

<div class="animate-fade-in-up" x-data="{ 
    historyModalOpen: false, 
    historyLead: null, 
    historyLoading: false,
    historyData: [],
    async openHistory(lead) {
        this.historyLead = lead;
        this.historyModalOpen = true;
        this.historyLoading = true;
        this.historyData = [];
        try {
            const resp = await fetch(`/owner/lead/${lead.id}/history`);
            const data = await resp.json();
            this.historyData = data.history;
        } catch (e) {
            console.error(e);
        } finally {
            this.historyLoading = false;
        }
    },
    formatDate(dateStr) {
      if(!dateStr) return 'N/A';
      return new Date(dateStr).toLocaleString();
    },
    formatDuration(seconds) {
      if(!seconds) return '0s';
      const mins = Math.floor(seconds / 60);
      const secs = seconds % 60;
      return mins > 0 ? `${mins}m ${secs}s` : `${secs}s`;
    }
}">
    <!-- Header Section -->
    <div class="mb-8 flex md:flex-row flex-col justify-between md:items-end">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 border-b-4 border-primary inline-block pb-1">Owner Dashboard</h2>
        <p class="text-sm font-medium text-gray-500 mt-2">Welcome back, <%= user.name %></p>
      </div>
    </div>
  <div class="px-4 py-4 sm:px-0">
    <!-- Actions Section -->
    <div x-show="activeTab === 'upload'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 transform translate-y-4" x-transition:enter-end="opacity-100 transform translate-y-0" class="space-y-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Stat Card -->
        <div class="bg-white shadow rounded-2xl border border-gray-100 flex items-center p-6 h-full">
          <div class="p-3 rounded-xl bg-blue-50 text-blue-500 mr-4">
            <svg class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500 truncate">Total Leads</p>
            <p class="mt-1 text-4xl font-semibold text-gray-900"><%= stats.total %></p>
          </div>
        </div>

        <!-- Upload Card -->
        <div class="bg-white shadow rounded-2xl border border-gray-100 p-6 md:col-span-1 lg:col-span-2 h-full">
       <div class="flex justify-between items-center mb-4">
         <h3 class="text-lg leading-6 font-bold text-gray-900">Upload New Leads (CSV/Excel)</h3>
         <a href="/sample_leads.csv" download class="text-sm font-medium text-blue-600 hover:text-blue-500 flex items-center transition-colors">
           <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
           Download Sample
         </a>
       </div>
       <form action="/owner/upload-leads" method="POST" enctype="multipart/form-data" class="flex items-center space-x-4">
         <div class="flex-1">
           <label class="block sr-only">Choose file</label>
           <input type="file" name="leads_file" accept=".csv, .xlsx, .xls" required class="block w-full text-sm text-gray-500
             file:mr-4 file:py-2 file:px-4
             file:rounded-full file:border-0
             file:text-sm file:font-semibold
             file:bg-container file:text-primary
             hover:file:bg-red-100"
           />
         </div>
         <button type="submit" class="btn-primary flex items-center shrink-0">
           <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-2">
             <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
           </svg>
           Upload
         </button>
       </form>
       <div class="mt-4 flex items-center text-xs text-gray-400 font-medium">
         <svg class="w-4 h-4 mr-1.5 text-blue-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
         </svg>
         Supported: .csv, .xlsx, .xls | Required columns: Name, Phone
       </div>
       <% if (locals.uploadMsg) { %>
         <p class="mt-3 text-sm text-green-600 font-bold flex items-center">
            <svg class="w-4 h-4 mr-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <%= uploadMsg %>
         </p>
       <% } %>
       <% if (locals.errorMsg) { %>
         <p class="mt-3 text-sm text-red-600 font-bold flex items-center">
            <svg class="w-5 h-5 mr-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            <%= errorMsg %>
         </p>
       <% } %>
      </div>
    </div> <!-- Close Grid wrapper -->

    <!-- Leads Table -->
    <div class="bg-white shadow rounded-2xl overflow-hidden border border-gray-100">
        <div class="px-6 py-5 border-b border-gray-200 bg-gray-50/50 flex justify-between items-center">
          <h3 class="text-lg leading-6 font-bold text-gray-900">Your Leads</h3>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
            Total: <%= locals.leads ? leads.length : 0 %>
          </span>
        </div>
        
        <div class="overflow-x-auto max-h-[400px] overflow-y-auto relative hidden-scrollbar border-t border-gray-100">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm border-b border-gray-200">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mobile No.</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Assigned To</th>
                 <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Added On</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% if (locals.leads && leads.length > 0) { %>
                <% leads.forEach(function(lead) { %>
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                      <div class="flex flex-col">
                        <span><%= lead.name %></span>
                        <% if (lead.outcomes && lead.outcomes.length > 0) { %>
                          <span class="text-[10px] text-primary font-bold uppercase mt-1">Last: <%= lead.outcomes[0].outcome_type %></span>
                        <% } %>
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= lead.phone %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                      <% if (lead.telecaller) { %>
                        <span class="inline-flex items-center gap-1.5">
                          <span class="w-2 h-2 rounded-full bg-blue-400 shrink-0"></span>
                          <%= lead.telecaller.device_alias || lead.telecaller.name %>
                        </span>
                      <% } else { %>
                        <span class="text-gray-400 italic text-xs">Unassigned</span>
                      <% } %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <% if (lead.status === 'PENDING') { %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800"><%= lead.status %></span>
                      <% } else if (lead.status === 'ANSWERED') { %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800"><%= lead.status %></span>
                      <% } else { %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800"><%= lead.status %></span>
                      <% } %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= new Date(lead.created_at).toLocaleDateString() %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <button @click="openHistory({id: '<%= lead.id %>', name: '<%= lead.name.replace(/'/g, "\\'") %>', phone: '<%= lead.phone %>'})" class="text-primary hover:text-red-700 bg-red-50 p-2 rounded-lg transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      </button>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="px-6 py-8 text-center text-sm text-gray-500 font-medium italic">No leads found. Upload a file to get started!</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Assign Unassigned Leads Panel -->
      <div class="bg-white shadow rounded-2xl border border-gray-100 p-6">
        <div class="flex flex-col sm:flex-row sm:items-end gap-4">
          <div class="flex-1">
            <h3 class="text-base font-bold text-gray-900 mb-1">Assign Unassigned Leads</h3>
            <p class="text-xs text-gray-400 mb-3">Select a telecaller below to assign all currently <span class="font-semibold text-amber-600">unassigned</span> leads to them.</p>
            <label class="block text-xs font-semibold text-gray-500 mb-1">Select Telecaller <span class="text-red-500">*</span></label>
            <form action="/owner/assign-leads" method="POST" class="flex items-center gap-6">
              <select name="telecaller_id" required
                class="flex-1 block rounded-xl border border-gray-200 bg-gray-50 text-sm text-gray-700 py-2 px-3 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all">
                <option value="">— Select a Telecaller —</option>
                <% if (locals.telecallers && telecallers.length > 0) { %>
                  <% telecallers.forEach(function(tc) { %>
                    <option value="<%= tc.id %>"><%= tc.name %></option>
                  <% }); %>
                <% } else { %>
                  <option disabled>No telecallers assigned to you yet</option>
                <% } %>
              </select>
              <button type="submit" class="btn-primary flex items-center shrink-0">
                <svg class="w-4 h-4 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Assign All Unassigned
              </button>
            </form>
          </div>
        </div>

        <!-- Assign feedback messages -->
        <% if (locals.assignMsg) { %>
          <p class="mt-4 text-sm text-green-600 font-bold flex items-center">
            <svg class="w-4 h-4 mr-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <%= assignMsg %>
          </p>
        <% } %>
        <% if (locals.assignError) { %>
          <p class="mt-4 text-sm text-red-600 font-bold flex items-center">
            <svg class="w-5 h-5 mr-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            <%= assignError %>
          </p>
        <% } %>
      </div>
      
    </div>

    <!-- Live Activity Feed -->
    <div x-cloak x-show="activeTab === 'activity'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 transform translate-y-4" x-transition:enter-end="opacity-100 transform translate-y-0" class="bg-white shadow rounded-2xl overflow-hidden border border-gray-100">
      <div class="px-6 py-5 border-b border-gray-200 bg-gray-50/50 flex justify-between items-center">
        <h3 class="text-lg leading-6 font-bold text-gray-900">Live Call Activity</h3>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
          <span class="w-2 h-2 mr-1.5 bg-green-500 rounded-full animate-pulse"></span>
          Live
        </span>
      </div>

      <!-- Live Activity Stats -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 px-6 py-4 bg-gray-50/30 border-b border-gray-100">
        <div class="bg-white overflow-hidden shadow-sm hover:shadow rounded-lg p-3 border border-gray-100 flex items-center transition-all duration-200">
          <div class="p-2 rounded-lg bg-amber-50 text-amber-500 mr-4">
            <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500 truncate">Pending Calls</p>
            <p class="mt-1 text-2xl md:text-3xl font-semibold text-gray-900"><%= stats.pending %></p>
          </div>
        </div>

        <div class="bg-white overflow-hidden shadow-sm hover:shadow rounded-lg p-3 border border-gray-100 flex items-center transition-all duration-200">
          <div class="p-2 rounded-lg bg-green-50 text-emerald-500 mr-4">
            <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500 truncate">Answered</p>
            <p class="mt-1 text-2xl md:text-3xl font-semibold text-gray-900" id="stat-answered"><%= stats.answered %></p>
          </div>
        </div>
      </div>
       <div class="p-6">
           <ul id="live-calls" class="divide-y divide-gray-200">
             <li class="py-4 text-center text-gray-500 text-sm italic" id="empty-state">Waiting for fresh call logs via Socket...</li>
           </ul>
       </div>
    </div>
  </div>
</div>

<script>
  socket.emit('join_dashboard', '<%= user.id %>');

  socket.on('new_call_log', (data) => {
    const list = document.getElementById('live-calls');
    const emptyState = document.getElementById('empty-state');
    if (emptyState) emptyState.remove();

    // Increment Answered Stat if answered
    if(data.status === 'ANSWERED') {
      const ansEl = document.getElementById('stat-answered');
      if(ansEl) ansEl.innerText = parseInt(ansEl.innerText) + 1;
    }

    const li = document.createElement('li');
    li.id = `log-${data.log_id}`;
    li.className = "py-4 flex flex-col animate-fade-in-up group";
    
    let badgeClass = data.status === 'ANSWERED' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800';
    let audioMarkup = data.recording_url ? `<audio controls src="${data.recording_url}" class="h-8 mt-2 w-full max-w-xs outline-none"></audio>` : '';
    let timestamp = new Date().toLocaleTimeString();

    li.innerHTML = `
      <div class="flex justify-between items-start">
        <div class="flex-1">
          <div class="flex items-center">
              <span class="text-sm font-bold text-gray-900 mr-2">${data.lead_name}</span>
              <span class="text-xs text-gray-500">(${data.lead_phone})</span>
          </div>
          <div class="text-[10px] font-bold text-gray-400 uppercase tracking-tighter mt-0.5">${timestamp}</div>
          <div class="text-xs text-gray-500 mt-1 flex items-center">
            <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            <span class="font-medium text-gray-700">${data.telecaller_name}</span> 
            <span class="mx-2 text-gray-300">|</span>
            <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            ${data.duration}s
          </div>
          <div class="recording-container">${audioMarkup}</div>
          <div class="outcome-container mt-2"></div>
        </div>
        <div class="flex flex-col items-end">
          <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-[10px] font-bold uppercase ${badgeClass} shadow-sm">
            ${data.status}
          </span>
        </div>
      </div>
    `;
    
    list.prepend(li);
    
    if (list.children.length > 10) {
      list.removeChild(list.lastChild);
    }
  });

  socket.on('recording_ready', (data) => {
    const logItem = document.getElementById(`log-${data.log_id}`);
    if (logItem) {
      const container = logItem.querySelector('.recording-container');
      if (container && !container.querySelector('audio')) {
        container.innerHTML = `<audio controls src="${data.recording_url}" class="h-8 mt-2 w-full max-w-xs outline-none"></audio>`;
      }
    }
  });

  socket.on('call_outcome_added', (data) => {
    const logItem = document.getElementById(`log-${data.log_id}`);
    if (logItem) {
      const container = logItem.querySelector('.outcome-container');
      if (container) {
        container.innerHTML = `
          <div class="bg-gray-50 rounded-xl p-3 border border-gray-100 shadow-inner animate-fade-in-up">
            <div class="flex items-center gap-2 mb-1">
              <span class="px-1.5 py-0.5 bg-primary text-white text-[9px] font-bold rounded uppercase">${data.outcome_type}</span>
              ${data.next_reminder ? `<span class="text-[9px] text-amber-600 font-bold flex items-center"><svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>${new Date(data.next_reminder).toLocaleDateString()}</span>` : ''}
            </div>
            <p class="text-[11px] text-gray-600 italic">"${data.remarks || 'No remarks provided'}"</p>
          </div>
        `;
      }
    }
  });
</script>

<!-- Lead History Modal -->
<div 
  x-show="historyModalOpen" 
  class="fixed inset-0 z-50 overflow-y-auto" 
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-cloak
>
  <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 transition-opacity" aria-hidden="true" @click="historyModalOpen = false">
      <div class="absolute inset-0 bg-gray-500 opacity-75 backdrop-blur-sm"></div>
    </div>

    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

    <div 
      class="inline-block align-bottom bg-white rounded-3xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full"
      x-show="historyModalOpen"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
      x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
    >
      <div class="bg-white px-6 py-6">
        <div class="flex justify-between items-center mb-6">
          <div>
            <h3 class="text-2xl font-bold text-gray-900 leading-tight" x-text="historyLead?.name"></h3>
            <p class="text-sm text-gray-500 font-medium" x-text="historyLead?.phone"></p>
          </div>
          <button @click="historyModalOpen = false" class="bg-gray-100 hover:bg-gray-200 text-gray-500 p-2 rounded-full transition-colors">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l18 18" />
            </svg>
          </button>
        </div>

        <div class="max-h-[60vh] overflow-y-auto pr-2 custom-scrollbar">
          <template x-if="historyLoading">
            <div class="flex flex-col items-center justify-center py-12">
              <div class="w-10 h-10 border-4 border-primary border-t-transparent rounded-full animate-spin mb-4"></div>
              <p class="text-sm text-gray-500 font-medium tracking-wide">Fetching call history...</p>
            </div>
          </template>

          <template x-if="!historyLoading && historyData.length === 0">
            <div class="text-center py-12 bg-gray-50 rounded-2xl border-2 border-dashed border-gray-100">
              <p class="text-sm text-gray-500 font-medium italic">No call history found for this lead.</p>
            </div>
          </template>

          <div class="space-y-6">
            <template x-for="log in historyData" :key="log.id">
              <div class="relative pl-8 pb-2 border-l-2 border-gray-100 last:border-0 last:pb-0">
                <!-- Timeline Dot -->
                <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-white border-2 border-primary shadow-sm"></div>
                
                <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                  <div class="flex justify-between items-start mb-3">
                    <div>
                      <span class="text-xs font-bold text-gray-400 uppercase tracking-widest block mb-1" x-text="formatDate(log.created_at)"></span>
                      <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold uppercase shadow-sm"
                              :class="log.status === 'ANSWERED' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'"
                              x-text="log.status"></span>
                        <span class="text-sm font-semibold text-gray-700" x-text="formatDuration(log.duration_seconds)"></span>
                      </div>
                    </div>
                    <div class="text-right">
                       <span class="text-[10px] text-gray-400 font-medium flex items-center justify-end">
                         <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                         <span x-text="log.telecaller.device_alias || log.telecaller.name"></span>
                       </span>
                    </div>
                  </div>

                  <template x-if="log.recording_url">
                    <div class="mt-3">
                      <audio controls :src="log.recording_url" class="h-8 w-full outline-none"></audio>
                    </div>
                  </template>

                  <template x-if="log.outcome">
                    <div class="mt-4 bg-gray-50 rounded-2xl p-4 border border-gray-100 shadow-inner">
                      <div class="flex items-center gap-2 mb-2">
                        <span class="px-2 py-0.5 bg-primary text-white text-[10px] font-bold rounded-lg uppercase" x-text="log.outcome.outcome_type"></span>
                        <template x-if="log.outcome.next_reminder">
                          <span class="text-[10px] text-amber-600 font-bold flex items-center">
                            <svg class="w-3.5 h-3.5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <span x-text="new Date(log.outcome.next_reminder).toLocaleDateString()"></span>
                          </span>
                        </template>
                      </div>
                      <p class="text-xs text-gray-600 leading-relaxed italic" x-text="'&quot;' + (log.outcome.remarks || 'No remarks provided') + '&quot;'"></p>
                    </div>
                  </template>
                </div>
              </div>
            </template>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
.animate-fade-in-up {
  animation: fadeInUp 0.4s ease-out forwards;
}
.hidden-scrollbar::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
.hidden-scrollbar::-webkit-scrollbar-track {
  background: transparent;
}
.hidden-scrollbar::-webkit-scrollbar-thumb {
  background-color: #CBD5E1;
  border-radius: 20px;
}
.hidden-scrollbar::-webkit-scrollbar-thumb:hover {
  background-color: #94A3B8;
}
</style>

