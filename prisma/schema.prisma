generator client {
  provider = "prisma-client-js"
}

// v1.0.1 - Cache invalidation for additional_data

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  BUSINESS_OWNER
  TELECALLER
}

enum LeadStatus {
  PENDING
  ANSWERED
  MISSED
  BUSY
  INTERESTED
  ORDERED
  BOOKED
  REMIND_LATER
  LOST
  REJECTED
  CANCELLED
  CB_REQUEST
  LEFT_MSG
  CALL_DISCONNECT
  BANK_PTP
  FPTP
  PTP
  NOT_REACHABLE
  RNR
  OUT_OF_SERVICE
  SWITCH_OFF
  INCOMING_NOT_AVAIABLE
  PARTIAL_PAID
  ALREADY_PAID
  DEATH
  CSWN
  RTP
  HOT_LEAD
  WALK_IN
  CALLBACK
  FOLLOW_UP
  WARM_LEAD
  BUDGET_ISSUE
  PENDING_DECISION
  ONLINE
  EXISTING_STUDENT
  NOT_INTERESTED
  LANGUAGE_ISSUE
  SALE_DONE
}

model User {
  id            String   @id @default(uuid())
  device_id     String?  @unique
  name          String
  email         String?  @unique
  password_hash String?
  role          Role
  device_alias  String?
  phone         String?
  payment_terms Int?
  status        String   @default("Active")
  last_seen     DateTime?
  created_at    DateTime @default(now())
  owner_id      String?  @db.Text

  // Relations
  owned_leads  Lead[]  @relation("OwnerLeads")
  assigned_leads Lead[] @relation("TelecallerLeads")
  call_logs    CallLog[]
  owner        User?   @relation("TelecallerOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  telecallers  User[]  @relation("TelecallerOwner")
}



model Lead {
  id                String     @id @default(uuid())
  business_owner_id String
  telecaller_id     String?
  name              String
  phone             String
  status            LeadStatus @default(PENDING)
  file_name         String?    @default("Legacy Upload")
  additional_data   Json?
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  // Relations
  business_owner User      @relation("OwnerLeads", fields: [business_owner_id], references: [id], onDelete: Cascade)
  telecaller     User?     @relation("TelecallerLeads", fields: [telecaller_id], references: [id], onDelete: SetNull)
  call_logs      CallLog[]

  @@unique([business_owner_id, phone])
  @@index([business_owner_id])
  @@index([telecaller_id])
  @@index([status])
  @@index([business_owner_id, status])
}

model TelecallerStatus {
  telecaller_name String   @id
  device_id       String
  status          String
  last_seen_at    BigInt
  updated_at      DateTime @default(now())
}

model DeletedLead {
  id                String   @id @default(uuid())
  lead_id           String
  business_owner_id String
  deleted_at        DateTime @default(now())

  @@index([lead_id])
  @@index([business_owner_id])
}

model CallLog {
  id               String   @id @default(uuid())
  lead_id          String
  telecaller_id    String
  duration_seconds Int
  recording_url    String?
  call_status      String   @default("COMPLETED")
  outcome          String?
  notes            String?
  next_reminder_time BigInt?
  closing_format   String?
  ptp_amount       Float?
  local_log_id     String?
  created_at       DateTime     @default(now())

  // Relations
  lead       Lead @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  telecaller User @relation(fields: [telecaller_id], references: [id], onDelete: Cascade)

  @@unique([telecaller_id, local_log_id])
  @@index([lead_id])
  @@index([telecaller_id])
}
