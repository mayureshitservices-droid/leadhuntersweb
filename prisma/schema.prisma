generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  BUSINESS_OWNER
  TELECALLER
}

enum LeadStatus {
  PENDING
  ANSWERED
  MISSED
  BUSY
  INTERESTED
  ORDERED
  BOOKED
  REMIND_LATER
  LOST
  REJECTED
  CANCELLED
}

model User {
  id            String   @id @default(uuid())
  device_id     String?  @unique
  name          String
  email         String?  @unique
  password_hash String?
  role          Role
  device_alias  String?
  phone         String?
  payment_terms Int?
  status        String   @default("Active")
  created_at    DateTime @default(now())

  // Relations
  owned_leads        Lead[]                 @relation("OwnerLeads")
  assigned_leads     Lead[]                 @relation("TelecallerLeads")
  call_logs          CallLog[]
  telecaller_assigns TelecallerAssignment[] @relation("TelecallerAssignments")
  owner_assigns      TelecallerAssignment[] @relation("OwnerAssignments")
}

model TelecallerAssignment {
  id                String   @id @default(uuid())
  telecaller_id     String
  business_owner_id String
  created_at        DateTime @default(now())

  // Relations
  telecaller     User @relation("TelecallerAssignments", fields: [telecaller_id], references: [id], onDelete: Cascade)
  business_owner User @relation("OwnerAssignments", fields: [business_owner_id], references: [id], onDelete: Cascade)

  @@unique([telecaller_id, business_owner_id])
}

model Lead {
  id                String     @id @default(uuid())
  business_owner_id String
  telecaller_id     String?
  name              String
  phone             String
  status            LeadStatus @default(PENDING)
  created_at        DateTime   @default(now())

  // Relations
  business_owner User      @relation("OwnerLeads", fields: [business_owner_id], references: [id], onDelete: Cascade)
  telecaller     User?     @relation("TelecallerLeads", fields: [telecaller_id], references: [id], onDelete: SetNull)
  call_logs      CallLog[]

  @@unique([business_owner_id, phone])
}

model CallLog {
  id               String   @id @default(uuid())
  lead_id          String
  telecaller_id    String
  duration_seconds Int
  recording_url    String?
  status           String
  notes            String?
  created_at       DateTime @default(now())

  // Relations
  lead       Lead @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  telecaller User @relation(fields: [telecaller_id], references: [id], onDelete: Cascade)
}
